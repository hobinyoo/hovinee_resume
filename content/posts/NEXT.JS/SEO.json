le":"reader"}},"4337f030-0acd-4782-872d-c50c66fee38c":{"value":{"value":{"id":"4337f030-0acd-4782-872d-c50c66fee38c","version":4,"type":"text","created_time":1707879123049,"last_edited_time":1707879123049,"parent_id":"cb2a0843-c2cd-4afd-9820-032e97574dfd","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"3_LREc9ye05CZ7-C1tI3mA,\"start\",\"end\"","n":{"3_LREc9ye05CZ7-C1tI3mA,\"start\",\"end\"":{"s":{"x":"3_LREc9ye05CZ7-C1tI3mA","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"a061348f-9487-46c1-83c1-0cd408f60352":{"value":{"value":{"id":"a061348f-9487-46c1-83c1-0cd408f60352","version":3,"type":"code","properties":{"title":[["SEO란?이미 Next JS를 사용하고 있거나 사용하기로 마음 먹으셨다면 SEO에 대해 알고 있을 것이라고 생각되지만, 간단하게 설명드리자면Search EngineOptimization의 약자로 웹에 올리는 컨텐츠가 구글, 네이버, 다음 같은 검색 엔진으로부터 제대로 인식이 될 수 있도록 최적화를 하는 작업입니다. 최적화 방법에는 양질의 콘텐츠를 제공하거나, 접근성이나 성능적으로 뛰어난 웹을 개발하는 방법 등이 있지만 가장 기본적인 방법으로는 해당 페이지에 적합한 메타태그를 삽입해서 크롤러가 웹을 잘 분석해서 인덱싱 하는데 도움을 주는 방법입니다. 구글에서는 최대한 많은 페이지가 인덱싱 되는 것이 검색엔진 최적화에 도움이 된다고 언급했기 때문에 각 페이지마다 해당 페이지의 용도를 잘 설명해주는 메타태그를 삽입해주는 것이 좋습니다."]],"language":[["Plain Text"]]},"format":{"code_wrap":true},"created_time":1707879123887,"last_edited_time":1707879123892,"parent_id":"cb2a0843-c2cd-4afd-9820-032e97574dfd","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"Mglg0Bv-8MEnP_--r5Pwiw,\"start\",\"end\"","n":{"Mglg0Bv-8MEnP_--r5Pwiw,\"start\",\"end\"":{"s":{"x":"Mglg0Bv-8MEnP_--r5Pwiw","i":[{"t":"s"},{"t":"t","i":["Hheoh6PrQ7YL",1],"o":"start","l":413,"c":"SEO란?이미 Next JS를 사용하고 있거나 사용하기로 마음 먹으셨다면 SEO에 대해 알고 있을 것이라고 생각되지만, 간단하게 설명드리자면Search EngineOptimization의 약자로 웹에 올리는 컨텐츠가 구글, 네이버, 다음 같은 검색 엔진으로부터 제대로 인식이 될 수 있도록 최적화를 하는 작업입니다. 최적화 방법에는 양질의 콘텐츠를 제공하거나, 접근성이나 성능적으로 뛰어난 웹을 개발하는 방법 등이 있지만 가장 기본적인 방법으로는 해당 페이지에 적합한 메타태그를 삽입해서 크롤러가 웹을 잘 분석해서 인덱싱 하는데 도움을 주는 방법입니다. 구글에서는 최대한 많은 페이지가 인덱싱 되는 것이 검색엔진 최