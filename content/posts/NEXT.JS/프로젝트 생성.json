 설정 창을 연다. 3. 설정에서 Editor: Default Formatter 검색 Prettier -Code Formatter 선택 4. 설정에서 editor format on save 검색 체크 박스 체크해주기 5. Prettier 검색 본인이 편한대로 설정해주면 될 듯하다. 만약, 특정 파일만 설정 외의 값으로 지정하고 싶다면, .prettierrc 파일을 만들어서 루트 디렉토리 안에 넣어 추가 해주면 된다. 예시는 아래와 같다. { \"printWidth\": 120, \"tabWidth\": 4, \"singleQuote\": true, \"trailingComma.."]]},"format":{"bookmark_icon":"https://green-grapes.tistory.com/favicon.ico","bookmark_cover":"https://img1.daumcdn.net/thumb/R800x0/?scode=mtistory2&fname=https%3A%2F%2Fblog.kakaocdn.net%2Fdn%2FbZYpZ9%2FbtrG9T0KSQN%2FtUSKookDZDricg6W9Fdr61%2Fimg.jpg"},"created_time":1707875288473,"last_edited_time":1707875288475,"parent_id":"7bc4d5f7-1de1-46ca-9be1-73ba2e8153c3","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"z7sudVZTaoAA72J7GBkvIg,\"start\",\"end\"","n":{"z7sudVZTaoAA72J7GBkvIg,\"start\",\"end\"":{"s":{"x":"z7sudVZTaoAA72J7GBkvIg","i":[{"t":"s"},{"t":"t","i":["FYK3KqJVj0kB",1],"o":"start","l":22,"c":"[VSCode] prettier 설정하기"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"d2ee6e6e-4a3e-4c9d-b268-4ed1f23b8fc7":{"value":{"value":{"id":"d2ee6e6e-4a3e-4c9d-b268-4ed1f23b8fc7","version":188,"type":"numbered_list","properties":{"title":[["tailwind 플러그인 설정도 해야 2번이 적용된다"]]},"format":{"list_start_index":3},"created_time":1707874784735,"last_edited_time":1707875308165,"parent_id":"7bc4d5f7-1de1-46ca-9be1-73ba2e8153c3","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"WaVQcG_Sija_A3gaS8HK_w,\"start\",\"end\"","n":{"WaVQcG_Sija_A3gaS8HK_w,\"start\",\"end\"":{"s":{"x":"WaVQcG_Sija_A3gaS8HK_w","i":[{"t":"s"},{"t":"t","i":["p09dOvNZzdE3",1],"o":"start","l":29,"c":"tailwind 플러그인 설정도 해야 2번이 적용된다"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}}},"collection":{},"collection_view":{},"notion_user":{},"collection_query":{},"signed_urls":{"attachment:a0cf341f-bc53-46b5-acfe-f322bd8a1c06:S