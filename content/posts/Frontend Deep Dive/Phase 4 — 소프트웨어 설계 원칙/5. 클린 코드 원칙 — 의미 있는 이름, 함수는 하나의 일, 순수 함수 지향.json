ody\">{user.bio}</div>\n    </div>\n  );\n}\n\nfunction PostCard({ post }) {\n  return (\n    <div className=\"card\">\n      <div className=\"card-header\">{post.title}</div>\n      <div className=\"card-body\">{post.content}</div>\n    </div>\n  );\n}\n\n// ✅ — 공통 추출\nfunction Card({ title, body }) {\n  return (\n    <div className=\"card\">\n      <div className=\"card-header\">{title}</div>\n      <div className=\"card-body\">{body}</div>\n    </div>\n  );\n}\n\nfunction UserCard({ user }) {\n  return <Card title={user.name} body={user.bio} />;\n}\n\nfunction PostCard({ post }) {\n  return <Card title={post.title} body={post.content} />;\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35a23329-f081-80cd-aa19-f0fc11bc0aef":{"value":{"value":{"id":"35a23329-f081-80cd-aa19-f0fc11bc0aef","version":2,"type":"divider","created_time":1778221157803,"last_edited_time":1778221157825,"parent_id":"34a23329-f081-8010-8c96-d1156b1c0798","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"Jy2scOoyIApupsqK8cEFQA,\"start\",\"end\"","n":{"Jy2scOoyIApupsqK8cEFQA,\"start\",\"end\"":{"s":{"x":"Jy2scOoyIApupsqK8cEFQA","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35a23329-f081-80c2-aa97-ec2fd7443630":{"value":{"value":{"id":"35a23329-f081-80c2-aa97-ec2fd7443630","version":3,"type":"sub_header","properties":{"title":[["5. 조기 반환 (Early Return)"]]},"created_time":1778221157803,"last_edited_time":1778221157825,"parent_id":"34a23329-f081-8010-8c96-d1156b1c0798","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"OfenfO0dKXny6sub81lesg,\"start\",\"end\"","n":{"OfenfO0dKXny6sub81lesg,\"start\",\"end\"":{"s":{"x":"OfenfO0dKXny6sub81lesg","i":[{"t":"s"},{"t":"t","i":["6Sl5TfwRlDTO",1],"o":"start","l":23,"c":"5. 조기 반환 (Early Return)"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35a23329-f081-809