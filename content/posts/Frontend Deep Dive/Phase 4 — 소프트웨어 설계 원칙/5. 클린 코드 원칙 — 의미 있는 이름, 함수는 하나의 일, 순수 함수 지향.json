e = await fetch('/api/login', {\n    method: 'POST',\n    body: JSON.stringify(formData)\n  });\n  return response.json();\n}\n\nfunction saveAuthToken(token) {\n  localStorage.setItem('token', token);\n}\n\nasync function handleSubmit(formData) {\n  validateLoginForm(formData);\n  const data = await loginUser(formData);\n  saveAuthToken(data.token);\n  window.location.href = '/dashboard';\n}"]],"language":[["JavaScript"]]},"format":{"code_wrap":true},"created_time":1778221157799,"last_edited_time":1778221157825,"parent_id":"34a23329-f081-8010-8c96-d1156b1c0798","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"XRvc05WOXpgHoewcHTsXUw,\"start\",\"end\"","n":{"XRvc05WOXpgHoewcHTsXUw,\"start\",\"end\"":{"s":{"x":"XRvc05WOXpgHoewcHTsXUw","i":[{"t":"s"},{"t":"t","i":["Vj1Pd-1vqLv4",1],"o":"start","l":1022,"c":"// ❌ — 너무 많은 일\nasync function handleSubmit(formData) {\n  // 유효성 검사\n  if (!formData.email) throw new Error('이메일 필수');\n  if (!formData.password) throw new Error('비밀번호 필수');\n\n  // API 호출\n  const response = await fetch('/api/login', {\n    method: 'POST',\n    body: JSON.stringify(formData)\n  });\n\n  // 응답 처리\n  const data = await response.json();\n  localStorage.setItem('token', data.token);\n  window.location.href = '/dashboard';\n}\n\n// ✅ — 각자 하나의 일\nfunction validateLoginForm(formData) {\n  if (!formData.email) throw new Error('이메일 필수');\n  if (!formData.password) throw new Error('비밀번호 필수');\n}\n\nasync function loginUser(formData) {\n  const response = await fetch('/api/login', {\n    method: 'POST',\n    body: JSON.stringify(formData)\n  });\n  return response.json();\n}\n\nfunction saveAuthToken(token) {\n  localStorage.setItem('token', token);\n}\n\nasync function handleSubmit(formData) {\n  validateLoginForm(formData);\n  const data = await loginUser(formData);\n  saveAuthToken(data.token);\n  window.location.href = '/dashboard';\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35a23329-f081-80c1-a96c-d38d04b74a3a":{"value":{"value":{"id":"35a23329-f081-80c1-a96c-d38d04b74a3a","version":3,"type":"sub_sub_header","properties":{"title":[["React 컴포넌트"]]},"created_time":1778221157800,"last_edited_time":1778221157825,"parent_id":"34a23329-f081-8010-8c96-d1156b1c0798","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"J5CRZCiKi1upx765CpOjBg,\"start\",\"end\"","n":{"J5CRZCiKi1upx765CpOjBg,\"start\",\"end\"":{"s":{"x":"J5CRZCiKi1upx765CpOjBg","i":[{"t":"s"},{"t":"t","i":["sIqMArBuy3PF",1],"o":"start","l":10,"c":"React 컴포넌트"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35a23329-f081-80a1-a14a-ccb64b6e8507":{"value":{"value":{"id":"35a23329-f081-80a1-a14a-ccb64b6e8507","version":3,"type":"code","properties":{"title":[["// ❌ — 너무 많은 일\nfunction UserDashboard({ userId }) {\n  const [user, setUser] = useState(null);\n  const [posts, setPosts] = useState([]);\n  const [isLoading, setIsLoading] = useState(true);\n\n  useEffect(() => {\n    Promise.all([\n      fetch(`/api/users/${userId}`).then(r => r.json()),\n      fetch(`/api/posts/${userId}`).then(r => r.json()),\n    ]).then(([user, posts]) => {\n      setUser(user);\n      setPosts(posts);\n      setIsLoading(false);\n    });\n  }, [userId]);\n\n  if (isLoading) return <Spinner />;\n\n  return (\n    <div>\n      <img src={user.avatar} />\n      <h1>{user.name}</h1>\n      <p>{user.bio}</p>\n      {posts.map(post => (\n        <div key={post.id}>\n          <h3>{post.title}</h3>\n          <p>{post.content}</p>\n        </div>\n      ))}\n    </div>\n  );\n}\n\n// ✅ — 역할 분리\nfunction useUserData(userId) { ... }   // 데이터 패칭\nfunction UserProfile({ user }) { ... } // 프로필 UI\nfunction UserPostList({ posts }) { ... } // 포스트 UI\n\nfunction UserDashboard({ userId }) {\n  const { user, posts, isLoading } = useUserData(userId);\n  if (isLoading) return <Spinner />;\n  return (\n    <div>\n      <UserProfile user={user} />\n      <UserPostList posts={posts} />\n    </div>\n  );\n}"]],"language":[["JavaScript"]]},"format":{"code_wrap":true},"created_time":1778221157800,"last_edited_time":1778221157825,"parent_id":"34a23329-f081-8010-8c96-d1156b1c0798","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"5OHROXb0RukUYDs-sU9LTA,\"start\",\"end\"","n":{"5OHROXb0RukUYDs-sU9LTA,\"start\",\"end\"":{"s":{"x":"5OHROXb0RukUYDs-sU9LTA","i":[{"t":"s"},{"t":"t","i":["IYGEiFF4Q6kh",1],"o":"start","l":1179,"c":"// ❌ — 너무 많은 일\nfunction UserDashboard({ userId }) {\n  const [user, setUser] = useState(null);\n  const [posts, setPosts] = useState([]);\n  const [isLoading, setIsLoading] = useState(true);\n\n  useEffect(() => {\n    Promise.all([\n      fetch(`/api/users/${userId}`).then(r => r.json()),\n      fetch(`/api/posts/${userId}`).then(r => r.json()),\n    ]).then(([user, posts]) => {\n      setUser(user);\n      setPosts(posts);\n      setIsLoading(false);\n    });\n  }, [userId]);\n\n  if (isLoading) return <Spinner />;\n\n  return (\n    <div>\n      <img src={user.avatar} />\n      <h1>{user.name}</h1>\n      <p>{user.bio}</p>\n      {posts.map(post => (\n        <div key={post.id}>\n          <h3>{post.title}</h3>\n          <p>{post.content}</p>\n        </div>\n      ))}\n    </div>\n  );\n}\n\n// ✅ — 역할 분리\nfunction useUserData(userId) { ... }   // 데이터 패칭\nfunction UserProfile({ user }) { ... } // 프로필 UI\nfunction UserPostList({ posts }) { ... } // 포스트 UI\n\nfunction UserDashboard({ userId }) {\n  const { user, posts, isLoading } = useUserData(userId);\n  if (isLoading) return <Spinner />;\n  return (\n    <div>\n      <UserProfile user={user} />\n      <UserPostList posts={posts} />\n    </div>\n  );\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35a23329-f081-80d4-9c1f-feead690f3fc":{"value":{"value":{"id":"35a23329-f081-80d4-9c1f-feead690f3fc","version":2,"type":"divid