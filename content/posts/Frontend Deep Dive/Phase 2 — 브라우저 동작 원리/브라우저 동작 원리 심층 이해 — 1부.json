() {\n  console.log('hi')   // 3. 쌓임 → 실행 → 제거\n}                     // 4. greet 제거\ngreet()               // 1. greet 쌓임 → 2. 내부 실행\n\n// Heap — 실제 데이터 저장\nconst user = { name: 'hovin' }\n// user 변수(참조) → Call Stack\n// { name: 'hovin' } 실제 객체 → Heap"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34523329-f081-807b-9b7c-cf1048145908":{"value":{"value":{"id":"34523329-f081-807b-9b7c-cf1048145908","version":2,"type":"divider","created_time":1776415466421,"last_edited_time":1776415466442,"parent_id":"34523329-f081-80c9-82ea-db9caad70b50","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"EkNvyXGpkBJoDssCmqLf9w,\"start\",\"end\"","n":{"EkNvyXGpkBJoDssCmqLf9w,\"start\",\"end\"":{"s":{"x":"EkNvyXGpkBJoDssCmqLf9w","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34523329-f081-80be-88d0-f86280179c2d":{"value":{"value":{"id":"34523329-f081-80be-88d0-f86280179c2d","version":3,"type":"sub_header","properties":{"title":[["5. URL 입력부터 화면까지 — 탐색 흐름"]]},"created_time":1776415466421,"last_edited_time":1776415466442,"parent_id":"34523329-f081-80c9-82ea-db9caad70b50","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"UIWr8daDvpO8bS8BDK1N3g,\"start\",\"end\"","n":{"UIWr8daDvpO8bS8BDK1N3g,\"start\",\"end\"":{"s":{"x":"UIWr8daDvpO8bS8BDK1N3g","i":[{"t":"s"},{"t":"t","i":["etWc_FeJyQjB",1],"o":"start","l":24,"c":"5. URL 입력부터 화면까지 — 탐색 흐름"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34523329-f081-8032-baf5-ded35fbf440e":{"value":{"value":{"id":"34523329-f081-8032-baf5-ded35fbf440e","version":3,"type":"code","properties":{"title":[["주소창에 URL 입력\n        ↓\n[브라우저 프로세스]\nUI 스레드: \"검색어야 URL이야?\" 판단\n        ↓\n네트워크 스레드\n  DNS 조회 → 서버 IP 찾기\n  TLS 연결 → HTTPS 핸드셰이크\n  서버에 HTTP 요청 전송\n        ↓\n응답 수신\n  Content-Type 확인 (HTML? 파일?)\n  SafeBrowsing 검사 (악성 사이트?)\n  CORB 검사 (크로스 사이트 데이터 차단)\n        