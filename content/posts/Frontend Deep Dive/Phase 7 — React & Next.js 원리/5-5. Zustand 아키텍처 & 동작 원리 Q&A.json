hPFyVNaBCzg0VRIg-A,\"start\",\"end\"":{"s":{"x":"9NdvhPFyVNaBCzg0VRIg-A","i":[{"t":"s"},{"t":"t","i":["5824Xd_Q9Oxe",1],"o":"start","l":17,"c":"Q3. Store 내부 구현은?"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-809b-b964-e98a89568a7c":{"value":{"value":{"id":"35f23329-f081-809b-b964-e98a89568a7c","version":4,"type":"text","properties":{"title":[["A.",[["b"]]]]},"created_time":1778656137490,"last_edited_time":1778656137521,"parent_id":"35f23329-f081-809e-a136-e5c9e848764b","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"GhTJu5ge_xcYUEzwiqkuMw,\"start\",\"end\"","n":{"GhTJu5ge_xcYUEzwiqkuMw,\"start\",\"end\"":{"s":{"x":"GhTJu5ge_xcYUEzwiqkuMw","i":[{"t":"s"},{"t":"t","i":["4vk4zhBY8e0f",1],"o":"start","l":2,"c":"A.","b":[{"t":"a","x":"GhTJu5ge_xcYUEzwiqkuMw","l":"","i":["4vk4zhBY8e0f",3],"s":{"i":["4vk4zhBY8e0f",1],"a":"b"},"e":{"i":"end","a":"b"},"a":["b"]}]},{"t":"e","b":[]}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-80a5-a29c-d7a3790e9469":{"value":{"value":{"id":"35f23329-f081-80a5-a29c-d7a3790e9469","version":3,"type":"code","properties":{"title":[["const createStoreImpl = (createState) => {\n  let state: T\n  const listeners = new Set<Listener>()  // 구독자 목록\n\n  const setState = (partial, replace) => {\n    const nextState = typeof partial === 'function'\n      ? partial(state)\n      : partial\n\n    if (!Object.is(nextState, state)) {  // 변경 감지\n      const previousState = state\n      state = replace\n        ? nextState\n        : Object.assign({}, state, nextState)  // partial update\n\n      listeners.forEach(listener =>\n        listener(state, previousState)  // 구독자 알림\n      )\n    }\n  }\n\n  const subscribe = (listener) => {\n    listeners.add(listener)\n    return () => listeners.delete(listener)  // unsubscribe 반환\n  }\n\n  state = createState(setState, getState, api)\n  return api\n}"]],"language":[["TypeScript"]]},"format":{"code_wrap":true},"created_time":1778656137491,"last_edited_time":1778656137521,"parent_id":"35f23329-f081-809e-a136-e5c9e848764b","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"f0OpslseJoUI_TF5XXHt4w,\"start\",\"end\"","n":{"f0OpslseJoUI_TF5XXHt4w,\"start\",\"end\"":{"s":{"x":"f0OpslseJoUI_TF5XXHt4w","i":[{"t":"s"},{"t":"t","i":["jUIIhT8wDt_X",1],"o":"start","l":735,"c":"const createStoreImpl = (createState) => {\n  let state: T\n  const listeners = new Set<Listener>()  // 구독자 목록\n\n  const setState = (partial, replace) => {\n    const nextState = typeof partial === 'function'\n      ? partial(state)\n      : partial\n\n    if (!Object.is(nextState, state)) {  // 변경 감지\n      const previousState = state\n      state = replace\n        ? nextState\n        : Object.assign({}, state, nextState)  // partial update\n\n      listeners.forEach(listener =>\n        listener(state, previousState)  // 구독자 알림\n      )\n    }\n  }\n\n  const subscribe = (listener) => {\n    listeners.add(listener)\n    return () => listeners.delete(listener)  // unsubscribe 반환\n  }\n\n  state = createState(setState, getState, api)\n  return api\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-80fc-a66e-d8b729f4562b":{"value":{"value":{"id":"35f23329-f081-80fc-a66e-d8b729f4562b","version":3,"type":"text","properties":{"title":[["핵심:"]]},"created_time":1778656137491,"last_edited_time":1778656137521,"parent_id":"35f23329-f081-809e-a136-e5c9e848764b","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"ArVaw7dM1t0PoaVBmZTR_Q,\"start\",\"end\"","n":{"ArVaw7dM1t0PoaVBmZTR_Q,\"start\",\"end\"":{"s":{"x":"ArVaw7dM1t0PoaVBmZTR_Q","i":[{"t":"s"},{"t":"t","i":["jO1YiftiOLQd",1],"o":"start","l":3,"c":"핵심:"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-80bf-93bd-dbbaefde2e43":{"value":{"value":{"id":"35f