f081-8056-9b7f-d4a353293854","version":4,"type":"text","properties":{"title":[["store 인스턴스를 Context로 공유 (값이 아닌 인스턴스):",[["b"]]]]},"created_time":1778656103003,"last_edited_time":1778656103038,"parent_id":"35f23329-f081-80a6-a6c5-e956db2695e5","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"_lLGciq4bmh61lb4aKPZiQ,\"start\",\"end\"","n":{"_lLGciq4bmh61lb4aKPZiQ,\"start\",\"end\"":{"s":{"x":"_lLGciq4bmh61lb4aKPZiQ","i":[{"t":"s"},{"t":"t","i":["-wlMBRWZwMBV",1],"o":"start","l":37,"c":"store 인스턴스를 Context로 공유 (값이 아닌 인스턴스):","b":[{"t":"a","x":"_lLGciq4bmh61lb4aKPZiQ","l":"","i":["-wlMBRWZwMBV",38],"s":{"i":["-wlMBRWZwMBV",1],"a":"b"},"e":{"i":"end","a":"b"},"a":["b"]}]},{"t":"e","b":[]}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-80d5-8d35-fac7bb4afd9a":{"value":{"value":{"id":"35f23329-f081-80d5-8d35-fac7bb4afd9a","version":3,"type":"code","properties":{"title":[["import { createStore, useStore } from 'zustand'\n\nconst BearStoreContext = createContext(null)\n\nconst BearStoreProvider = ({ children, initialBears }) => {\n  const [store] = useState(() =>\n    createStore((set) => ({\n      bears: initialBears,  // props로 진짜 초기화 가능!\n      actions: {\n        increasePopulation: (by) =>\n          set(state => ({ bears: state.bears + by })),\n      },\n    }))\n  )\n  // useState initializer → 최초 1회만 실행\n\n  return (\n    <BearStoreContext.Provider value={store}>\n      {children}\n    </BearStoreContext.Provider>\n  )\n}\n\n// 커스텀 훅\nconst useBearStore = (selector) => {\n  const store = useContext(BearStoreContext)\n  if (!store) throw new Error('Missing BearStoreProvider')\n  return useStore(store, selector)\n}\n\n// atomic selector\nexport const useBears = () => useBearStore(state => state.bears)"]],"language":[["JavaScript"]]},"format":{"code_wrap":true},"created_time":1778656103004,"last_edited_time":1778656103038,"parent_id":"35f23329-f081-80a6-a6c5-e956db2695e5","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"PF48L0tYIg7l8FwMXe0Usg,\"start\",\"end\"","n":{"PF48L0tYIg7l8FwMXe0Usg,\"start\",\"end\"":{"s":{"x":"PF48L0tYIg7l8FwMXe0Usg","i":[{"t":"s"},{"t":"t","i":["vtwGNG9b4vpu",1],"o":"start","l":818,"c":"import { createStore, useStore } from 'zustand'\n\nconst BearStoreContext = createContext(null)\n\nconst BearStoreProvider = ({ children, initialBears }) => {\n  const [store] = useState(() =>\n    createStore((set) => ({\n      bears: initialBears,  // props로 진짜 초기화 가능!\n      actions: {\n        increasePopulation: (by) =>\n          set(state => ({ bears: state.bears + by })),\n      },\n    }))\n  )\n  // useState initializer → 최초 1회만 실행\n\n  return (\n    <BearStoreContext.Provider value={store}>\n      {children}\n    </BearStoreContext.Provider>\n  )\n}\n\n// 커스텀 훅\nconst useBearStore = (selector) => {\n  const store = useContext(BearStoreContext)\n  if (!store) throw new Error('Missing BearStoreProvider')\n  return useStore(store, selector)\n}\n\n// atomic selector\nexport const useBears = () => useBearStore(state => state.bears)"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-8036-9a37-c7d892781e78":{"value":{"value":{"id":"35f23329-f081-8036-9a37-c7d892781e78","version":2,"type":"divider","created_time":1778656103004,"last_edited_time":1778656103038,"parent_id":"35f23329-f081-80a6-a6c5-e956db2695e5","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"XhsYgzQuxgAjdfxjx_teJg,\"start\",\"end\"","n":{"XhsYgzQuxgAjdfxjx_teJg,\"start\",\"end\"":{"s":{"x":"XhsYgzQuxgAjdfxjx_teJg","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-804e-aad5-c1b349cbb66e":{"value":{"value":{"id":"35f23329-f081-804e-aad5-c1b349cbb66e","version":3,"type":"sub_header","properties":{"title":[["Q5. create() vs createStore() 차이?"]]},"cr