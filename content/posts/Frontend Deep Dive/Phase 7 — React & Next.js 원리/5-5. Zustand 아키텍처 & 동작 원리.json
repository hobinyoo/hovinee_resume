3a329","crdt_format_version":1,"crdt_data":{"title":{"r":"OSxe7X7dJ-UvFaCZke0nbA,\"start\",\"end\"","n":{"OSxe7X7dJ-UvFaCZke0nbA,\"start\",\"end\"":{"s":{"x":"OSxe7X7dJ-UvFaCZke0nbA","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-8048-81bd-d3716eed063e":{"value":{"value":{"id":"35f23329-f081-8048-81bd-d3716eed063e","version":3,"type":"sub_header","properties":{"title":[["Store 내부 구현 — createStoreImpl"]]},"created_time":1778655251999,"last_edited_time":1778655252029,"parent_id":"35f23329-f081-8019-bf65-cbc393f95190","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"LTYKk8SnYjpCb0t9irSMog,\"start\",\"end\"","n":{"LTYKk8SnYjpCb0t9irSMog,\"start\",\"end\"":{"s":{"x":"LTYKk8SnYjpCb0t9irSMog","i":[{"t":"s"},{"t":"t","i":["SXUSipdHd17e",1],"o":"start","l":29,"c":"Store 내부 구현 — createStoreImpl"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-80c6-bf3b-c0c132085aa9":{"value":{"value":{"id":"35f23329-f081-80c6-bf3b-c0c132085aa9","version":3,"type":"code","properties":{"title":[["const createStoreImpl = (createState) => {\n  let state: T                          // 현재 state\n  const listeners = new Set<Listener>() // 구독자 목록 (Set)\n\n  const setState = (partial, replace) => {\n    const nextState = typeof partial === 'function'\n      ? partial(state)\n      : partial\n\n    if (!Object.is(nextState, state)) {  // 변경 감지\n      const previousState = state\n      state = replace ? nextState : Object.assign({}, state, nextState)\n      listeners.forEach(listener => listener(state, previousState)) // 구독자 알림\n    }\n  }\n\n  const getState = () => state\n\n  const subscribe = (listener) => {\n    listeners.add(listener)\n    return () => listeners.delete(listener)  // unsubscribe 반환\n  }\n\n  state = createState(setState, getState, api)\n  return api\n}"]],"language":[["TypeScript"]]},"format":{"code_wrap":true},"created_time":1778655252000,"last_edited_time":1778655252029,"parent_id":"35f23329-f081-8019-bf65-cbc393f95190","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"G91aJriIi1oTE0eV7InMNA,\"start\",\"end\"","n":{"G91aJriIi1oTE0eV7InMNA,\"start\",\"end\"":{"s":{"x":"G91aJriIi1oTE0eV7InMNA","i":[{"t":"s"},{"t":"t","i":["MpWaDc0Zfk2V",1],"o":"start","l":757,"c":"const createStoreImpl = (createState) => {\n  let state: T                          // 현재 state\n  const listeners = new Set<Listener>() // 구독자 목록 (Set)\n\n  const setState = (partial, replace) => {\n    const nextState = typeof partial === 'function'\n      ? partial(state)\n      : partial\n\n    if (!Object.is(nextState, state)) {  // 변경 감지\n      const previousState = state\n      state = replace ? nextState : Object.assign({}, state, nextState)\n      listeners.forEach(listener => listener(state, previousState)) // 구독자 알림\n    }\n  }\n\n  const getState = () => state\n\n  const subscribe = (listener) => {\n    listeners.add(listener)\n    return () => listeners.delete(listener)  // unsubscribe 반환\n  }\n\n  state = createState(setState, getState, api)\n  return api\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-8080-80e6-f94312cd0784":{"value":{"value":{"id":"35f23329-f081-8080-80e6-f94312cd0784","version":3,"type":"text","properties":{"title":[["핵심:"]]},"created_time":1778655252000,"last_edited_time":1778655252029,"parent_id":"35f23329-f081-8019-bf65-cbc393f95190","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"NdpFXxS1U62Smd6tHh_cAw,\"start\",\"end\"","n":{"NdpFXxS1U62Smd6tHh_cAw,\"start\",\"end\"":{"s":{"x":"NdpFXxS1U62Smd6tHh_cAw","i":[{"t":"s"},{"t":"t","i":["k-K-gT0ijKKF",1],"o":"start","l":3,"c":"핵심:"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-80c4-92ad-caa5bb4e053f":{"value":{"value":{"id":"35f23329-f081-80c4-92ad-caa5bb4