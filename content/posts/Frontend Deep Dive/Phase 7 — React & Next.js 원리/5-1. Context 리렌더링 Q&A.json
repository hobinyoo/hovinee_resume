alue={api}>\n      <UserContext.Provider value={user}>\n        {children}\n      </UserContext.Provider>\n    </UserAPIContext.Provider>\n  )\n}\n// user 바뀌어도 setUser만 쓰는 컴포넌트는 리렌더링 안 함"]],"language":[["JavaScript"]]},"format":{"code_wrap":true},"created_time":1778656023489,"last_edited_time":1778656023517,"parent_id":"35f23329-f081-80c5-bce9-df98b2095790","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"5WPS7aiygruWI3D2MkmZGA,\"start\",\"end\"","n":{"5WPS7aiygruWI3D2MkmZGA,\"start\",\"end\"":{"s":{"x":"5WPS7aiygruWI3D2MkmZGA","i":[{"t":"s"},{"t":"t","i":["qBoAfqr1GbjR",1],"o":"start","l":595,"c":"// ❌ 데이터와 setter 같은 Context\nconst AppContext = createContext({ user: null, setUser: () => {} })\n// user 바뀌면 setUser만 쓰는 컴포넌트도 리렌더링\n\n// ✅ 분리\nconst UserContext = createContext(null)\nconst UserAPIContext = createContext({ setUser: () => {} })\n\nfunction UserProvider({ children }) {\n  const [user, setUser] = useState(null)\n  const api = useMemo(() => ({ setUser }), [setUser])\n\n  return (\n    <UserAPIContext.Provider value={api}>\n      <UserContext.Provider value={user}>\n        {children}\n      </UserContext.Provider>\n    </UserAPIContext.Provider>\n  )\n}\n// user 바뀌어도 setUser만 쓰는 컴포넌트는 리렌더링 안 함"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-809c-b16e-fac4a801f868":{"value":{"value":{"id":"35f23329-f081-809c-b16e-fac4a801f868","version":2,"type":"divider","created_time":1778656023489,"last_edited_time":1778656023517,"parent_id":"35f23329-f081-80c5-bce9-df98b2095790","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"rL4EnRta8MiVW1rS-RWccA,\"start\",\"end\"","n":{"rL4EnRta8MiVW1rS-RWccA,\"start\",\"end\"":{"s":{"x":"rL4EnRta8MiVW1rS-RWccA","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"35f23329-f081-806d-ae62-f2a679000c47":{"value":{"value":{"id":"35f23