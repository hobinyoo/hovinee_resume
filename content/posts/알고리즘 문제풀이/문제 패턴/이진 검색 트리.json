rr) {\n        if (arr.length === 0) return [];\n        \n        const root = arr[0];\n        let i = 1;\n        \n        // BST 성질: 루트보다 작은 값들이 왼쪽 서브트리\n        while (i < arr.length && arr[i] < root) {\n            i++;\n        }\n        \n        const left = arr.slice(1, i);    // 왼쪽 서브트리\n        const right = arr.slice(i);      // 오른쪽 서브트리\n        \n        // DFS: 후위 순회 (왼쪽 → 오른쪽 → 루트)\n        return [\n            ...getPostorder(left),\n            ...getPostorder(right), \n            root\n        ];\n    }\n    \n    return getPostorder(preorder);\n}"]],"language":[["JavaScript"]]},"created_time":1757991798194,"last_edited_time":1757991806775,"parent_id":"20d23329-f081-8097-9aa1-c7232ce2e2c0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"Wq0OaZj6Am5bMcZXmg4Tcg,\"start\",\"end\"","n":{"Wq0OaZj6Am5bMcZXmg4Tcg,\"start\",\"end\"":{"s":{"x":"Wq0OaZj6Am5bMcZXmg4Tcg","i":[{"t":"s"},{"t":"t","i":["OxAE-qrv7xz6",1],"o":"start","l":612,"c":"function solution1(preorder) {\n    function getPostorder(arr) {\n        if (arr.length === 0) return [];\n        \n        const root = arr[0];\n        let i = 1;\n        \n        // BST 성질: 루트보다 작은 값들이 왼쪽 서브트리\n        while (i < arr.length && arr[i] < root) {\n            i++;\n        }\n        \n        const left = arr.slice(1, i);    // 왼쪽 서브트리\n        const right = arr.slice(i);      // 오른쪽 서브트리\n        \n        // DFS: 후위 순회 (왼쪽 → 오른쪽 → 루트)\n        return [\n            ...getPostorder(left),\n            ...getPostorder(right), \n            root\n        ];\n    }\n    \n    return getPostorder(preorder);\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"27023329-f081-80cb-84f5-c16096a117fb":{"value":{"value":{"id":"27023329-f081-80cb-84f5-c16096a117fb","version":2,"type":"table_row","properties":{"DF`:":[["소요시간"]],"Lvjv":[["완료"]],"RYpi":[["시간복잡도"]],"UrZ>":[["풀이방법"]],"YuMV":[["난이도 (주관적)"]],"mNH_":[["재도전"