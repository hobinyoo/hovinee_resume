          left: left === '.' ? null : left,\n            right: right === '.' ? null : right\n        };\n    }\n    \n    // DFS 순회\n    function preorder(node) {\n        if (!node) return '';\n        return node + preorder(tree[node].left) + preorder(tree[node].right);\n    }\n    \n    function inorder(node) {\n        if (!node) return '';\n        return inorder(tree[node].left) + node + inorder(tree[node].right);\n    }\n    \n    function postorder(node) {\n        if (!node) return '';\n        return postorder(tree[node].left) + postorder(tree[node].right) + node;\n    }\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}}},"collection":{},"collection_view":{},"notion_user":{},"collection_query":{},"signed_urls":{"attachment:c478bbea-3574-4312-87fc-5dede9c72bfe:SocialMediaPreviewImage.png":"https://file.notion.com/f/f/42226e73-10fb-44ef-86b2-97a01d83a329/c478bbea-3574-4312-87fc-5dede9c72bfe/SocialMediaPreviewImage.png?table=block&id=3ec23329-f081-8040-8946-e88026c363bc&spaceId=42226e73-10fb-44ef-86b2-97a01d83a329&expirationTimestamp=1790863200000&signature=3pSzFaTOMK8T68N2ewJcgaaC6ppXtZdRtVuYJPfAIAA"}}}