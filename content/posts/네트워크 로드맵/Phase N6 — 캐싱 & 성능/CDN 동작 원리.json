9c1bb-d40e-40b3-9b67-cd451b5f7f2e","version":3,"type":"text","properties":{"title":[["Purge가 있기 때문에 동적 콘텐츠도 CDN에 캐시할 수 있다. TTL을 길게 잡고, 업데이트 시 Purge하는 전략을 \"hold-till-told 캐싱\"이라고 부른다."]]},"created_time":1782118010429,"last_edited_time":1782118010429,"parent_id":"38723329-f081-8181-8152-e50734238c8a","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"NlRmsJHoacSOTE_R2Gm7CA,\"start\",\"end\"","n":{"NlRmsJHoacSOTE_R2Gm7CA,\"start\",\"end\"":{"s":{"x":"NlRmsJHoacSOTE_R2Gm7CA","i":[{"t":"s"},{"t":"t","i":["0TMKZudKWOt4",1],"o":"start","l":95,"c":"Purge가 있기 때문에 동적 콘텐츠도 CDN에 캐시할 수 있다. TTL을 길게 잡고, 업데이트 시 Purge하는 전략을 \"hold-till-told 캐싱\"이라고 부른다."},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"e6fa5bc6-b8ae-421b-934e-02577335b69d":{"value":{"value":{"id":"e6fa5bc6-b8ae-421b-934e-02577335b69d","version":2,"type":"divider","created_time":1782118010430,"last_edited_time":1782118010430,"parent_id":"38723329-f081-8181-8152-e50734238c8a","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"X8EWexjug23M40kzG_r0AA,\"start\",\"end\"","n":{"X8EWexjug23M40kzG_r0AA,\"start\",\"end\"":{"s":{"x":"X8EWexjug23M40kzG_r0AA","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"d8614c95-369e-46de-be57-5b6cd7192a86":{"value":{"value":{"id":"d8614c95-369e-46de-be57-5b6cd7192a86","version":3,"type":"sub_header","properties":{"title":[["정리 — 캐싱 레이어 전체 그림"]]},"format":{"toggleable":false},"created_time":1782118010430,"last_edited_time":1782118010430,"parent_id":"38723329-f081-8181-8152-e50734238c8a","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"4k9wJrJLEpadlbQ9yMFmcQ,\"start\",\"end\"","n":{"4k9wJrJLEpadlbQ9yMFmcQ,\"start\",\"end\"":{"s":{"x":"4k9wJrJLEpadlbQ9yMFmcQ","i":[{"t":"s"},{"t":"t","i":["cNW7xKqKZVAr",1],"o":"start","l