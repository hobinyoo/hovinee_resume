b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"KX0s8apn-oLyq5hDDbpxlw,\"start\",\"end\"","n":{"KX0s8apn-oLyq5hDDbpxlw,\"start\",\"end\"":{"s":{"x":"KX0s8apn-oLyq5hDDbpxlw","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"24aeb831-915e-4945-9357-2d9009a4b65e":{"value":{"value":{"id":"24aeb831-915e-4945-9357-2d9009a4b65e","version":15,"type":"sub_sub_header","properties":{"title":[["Q8. HTTP/2가 TLS를 사실상 강제하는 이유는 무엇인가요?"]]},"format":{"toggleable":false},"created_time":1779435550615,"last_edited_time":1779437893175,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"Hz8MdWaVRRxKeZjE321txg,\"start\",\"end\"","n":{"Hz8MdWaVRRxKeZjE321txg,\"start\",\"end\"":{"s":{"x":"Hz8MdWaVRRxKeZjE321txg","i":[{"t":"s"},{"t":"t","i":["12TmT23U6Az9",1],"o":"start","l":36,"c":"Q8. HTTP/2가 TLS를 사실상 강제하는 이유는 무엇인가요?"},{"t":"t","i":["h-5gB_OWPDeH",37],"o":["12TmT23U6Az9",36],"l":-2},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"8d77e495-ace1-4c4f-9709-f4eec7cdf9dc":{"value":{"value":{"id":"8d77e495-ace1-4c4f-9709-f4eec7cdf9dc","version":3,"type":"code","properties":{"title":[["A.\n스펙상 TLS는 선택 사항이지만,\nChrome과 Firefox 등 주요 브라우저가 TLS 없이는 HTTP/2를 지원하지 않습니다.\n\n이유\n  사용자 프라이버시 보호\n  포트 80에서 HTTP/1.1이 아닌 트래픽을 방해하는 미들박스 존재\n  TLS 사용 시 HTTP/2 협상 성공률이 더 높음\n\nALPN (협상 방식)\n  TLS 핸드셰이크 중에 HTTP/2 사용 여부 협상\n  클라이언트가 선호 목록 제시 → 서버가 최종 선택\n\n실질적 결론: HTTP/2 = HTTPS 위에서 동작"]],"language":[["Plain Text"]]},"created_time":1779435550616,"last_edited_time":1779435550616,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"YJuydDDrrSWhZ9xaijTqUA,\"start\",\"end\"","n":{"YJuydDDrrSWhZ9xaijTqUA,\"start\",\"end\"":{"s":{"x":"YJuydDDrrSWhZ9xaijTqUA","i":[{"t":"s"},{"t":"t","i":["A66WVHiScn4q",1],"o":"start","l":272,"c":"A.\n스펙상 TLS는 선택 사항이지만,\nChrome과 Firefox 등 주요 브라우저가 TLS 없이는 HTTP/2를 지원하지 않습니다.\n\n이유\n  사용자 프라이버시 보호\n  포트 80에서 HTTP/1.1이 아닌 트래픽을 방해하는 미들박스 존재\n  TLS 사용 시 HTTP/2 협상 성공률이 더 높음\n\nALPN (협상 방식)\n  TLS 핸드셰이크 중에 HTTP/2 사용 여부 협상\n  클라이언트가 선호 목록 제시 → 서버가 최종 선택\n\n실질적 결론: HTTP/2 = HTTPS 위에서 동작"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"c978d99e-7d28-4cb3-aa4c-3118828dd446":{"value":{"value":{"id":"c978d99e-7d28-4cb3-aa4c-3118828dd446","version":2,"type":"divider","created_time":1779435550617,"last_edited_time":1779435550617,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"uGoQ4kcP-9hneKM07rSu0g,\"start\",\"end\"","n":{"uGoQ4kcP-9hneKM07rSu0g,\"start\",\"end\"":{"s":{"x":"uGoQ4kcP-9hneKM07rSu0g","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1b9bab5f-a1ff-491d-ab61-a85b98291d68":{"value":{"value":{"id":"1b9bab5f-a1ff-491d-ab61-a85b98291d68","version":15,"type":"sub_sub_header","properties":{"title":[["Q9. HTTP/2에서 RST_STREAM은 무엇인가요?"]]},"format":{"toggleable":false},"created_time":1779435550617,"last_edited_time":1779437893175,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"Wy0DMk423ReiX2uc6Cskig,\"start\",\"end\"","n":{"Wy0DMk423ReiX2uc6Cskig,\"start\",\"end\"":{"s":{"x":"Wy0DMk423ReiX2uc6Cskig","i":[{"t":"s"},{"t":"t","i":["4tdqtIRZ8tnw",1],"o":"start","l":31,"c":"Q9. HTTP/2에서 RST_STREAM은 무엇인가요?"},{"t":"t","i":["NMXWPIVgfljF",32],"o":["4tdqtIRZ8tnw",31],"l":-2},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1ff71e7d-303b-4c8c-819e-4c9f94f696b0":{"value":{"value":{"id":"1ff71e7d-303b-4c8c-819e-4c9f94f696b0","version":3,"type":"code","properties":{"title":[["A.\n스트림을 취소하는 프레임입니다.\n\nHTTP/1.1 문제\n  요청을 중간에 취소하려면 TCP 연결을 끊어야 함\n  → 새 TCP 연결 = 3-way Handshake 비용 다시 발생\n\nHTTP/2 해결\n  RST_STREAM 프레임으로 해당 스트림만 취소\n  TCP 연결은 유지되어 다른 스트림에 영향 없음\n  불필요한 대역폭 낙비 방지"]],"language":[["Plain Text"]]},"created_time":1779435550618,"last_edited_time":1779435550618,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"vN76Uc-P5hZ8D4lrEpslBA,\"start\",\"end\"","n":{"vN76Uc-P5hZ8D4lrEpslBA,\"start\",\"end\"":{"s":{"x":"vN76Uc-P5hZ8D4lrEpslBA","i":[{"t":"s"},{"t":"t","i":["XOfYQ1a6iS0c",1],"o":"start","l":190,"c":"A.\n스트림을 취소하는 프레임입니다.\n\nHTTP/1.1 문제\n  요청을 중간에 취소하려면 TCP 연결을 끊어야 함\n  → 새 TCP 연결 = 3-way Handshake 비용 다시 발생\n\nHTTP/2 해결\n  RST_STREAM 프레임으로 해당 스트림만 취소\n  TCP 연결은 유지되어 다른 스트림에 영향 없음\n  불필요한 대역폭 낙비 방지"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"58aeb17d-afd2-4bda-a0da-f83b68e89148":{"value":{"value":{"id":"58aeb17d-afd2-4bda-a0da-f83b68e89148","version":2,"type":"divider","created_time":1779435550619,"last_edited_time":1779435550619,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"8BfoxVkNR8KAbGsi8YHI_A,\"start\",\"end\"","n":{"8BfoxVkNR8KAbGsi8YHI_A,\"start\",\"end\"":{"s":{"x":"8BfoxVkNR8KAbGsi8YHI_A","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"b0583cbb-671a-4ce4-a5ed-567ead1044fc":{"value":{"value":{"id":"b0583cbb-671a-4ce4-a5ed-567ead1044fc","version":3,"type":"sub_header","properties":{"title":[["HTTP/2의 영향"]]},"format":{"toggleable":false},"created_time":1779435550619,"last_edited_time":1779435550619,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"zypBUBh4xwzEmcqV7lXe6w,\"start\",\"end\"","n":{"zypBUBh4xwzEmcqV7lXe6w,\"start\",\"end\"":{"s":{"x":"zypBUBh4xwzEmcqV7lXe6w","i":[{"t":"s"},{"t":"t","i":["d5Otz5773e2F",1],"o":"start","l":10,"c":"HTTP/2의 영향"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"b11f1f07-92b7-48a6-af14-a679bff26acd":{"value":{"value":{"id":"b11f1f07-92b7-48a6-af14-a679bff26acd","version":15,"type":"sub_sub_header","properties":{"title":[["Q10. HTTP/2 도입 후 프론트엔드 개발 방식은 어떻게 바뀌었나요?"]]},"format":{"toggleable":false},"created_time":1779435550620,"last_edited_time":1779437893175,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"65qD8Todbr_aR3hNZuWmDQ,\"start\",\"end\"","n":{"65qD8Todbr_aR3hNZuWmDQ,\"start\",\"end\"":{"s":{"x":"65qD8Todbr_aR3hNZuWmDQ","i":[{"t":"s"},{"t":"t","i":["i-VdeCMsT_z8",1],"o":"start","l":40,"c":"Q10. HTTP/2 도입 후 프론트엔드 개발 방식은 어떻게 바뀌었나요?"},{"t":"t","i":["_st1EuWV50AA",41],"o":["i-VdeCMsT_z8",40],"l":-2},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"5969c5fb-5681-493c-8570-9570f333d263":{"value":{"value":{"id":"5969c5fb-5681-493c-8570-9570f333d263","version":3,"type":"code","properties":{"title":[["A.\nHTTP/1.1 시대의 성능 최적화 꼼수들이 역효과를 납니다.\n\n바뀌 것\n  스프라이팅    → 멀티플렉싱으로 불필요, 캐시 효율 저하\n  인라이닝      → 불필요\n  샤딩          → 연결 분산이 멀티플렉싱 효율 저하\n  파일 번들링   → 작은 파일 여럿이 캐시 효율상 유리할 수 있음\n\n과도기 문제\n  HTTP/1.1 + HTTP/2 클라이언트 공존 기간에는\n  두 환경 모두 최적화하기 어려움"]],"language":[["Plain Text"]]},"created_time":1779435550621,"last_edited_time":1779435550621,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"gSuT_Qw45vnkZcrn9q4Ngg,\"start\",\"end\"","n":{"gSuT_Qw45vnkZcrn9q4Ngg,\"start\",\"end\"":{"s":{"x":"gSuT_Qw45vnkZcrn9q4Ngg","i":[{"t":"s"},{"t":"t","i":["CUUi_dpsuQ3w",1],"o":"start","l":232,"c":"A.\nHTTP/1.1 시대의 성능 최적화 꼼수들이 역효과를 납니다.\n\n바뀌 것\n  스프라이팅    → 멀티플렉싱으로 불필요, 캐시 효율 저하\n  인라이닝      → 불필요\n  샤딩          → 연결 분산이 멀티플렉싱 효율 저하\n  파일 번들링   → 작은 파일 여럿이 캐시 효율상 유리할 수 있음\n\n과도기 문제\n  HTTP/1.1 + HTTP/2 클라이언트 공존 기간에는\n  두 환경 모두 최적화하기 어려움"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"74e95742-83f0-4fe9-993f-d88307eac4e0":{"value":{"value":{"id":"74e95742-83f0-4fe9-993f-d88307eac4e0","version":10,"type":"sub_sub_header","properties":{"title":[["Q11. 병렬 커넥션과 멀티플렉싱의 차이는 무엇인가요? ⭐"]]},"format":{"toggleable":false},"created_time":1779436598633,"last_edited_time":1779437753929,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"-jl-B1jvimZYAnbOn6pfog,\"start\",\"end\"","n":{"-jl-B1jvimZYAnbOn6pfog,\"start\",\"end\"":{"s":{"x":"-jl-B1jvimZYAnbOn6pfog","i":[{"t":"s"},{"t":"t","i":["mWdFQ49E-8Eb",1],"o":"start","l":30,"c":"Q11. 병렬 커넥션과 멀티플렉싱의 차이는 무엇인가요?"},{"t":"t","i":["OMUTYR55_qne",31],"o":["mWdFQ49E-8Eb",30],"l":2,"c":" ⭐"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"8f3f22b3-4aa7-4a9b-84a3-f663e5e7c24b":{"value":{"value":{"id":"8f3f22b3-4aa7-4a9b-84a3-f663e5e7c24b","version":4,"type":"code","properties":{"title":[["A.\n병렬 커넥션은 TCP 연결을 여러 개 만드는 것이고,\n멀티플렉싱은 TCP 연결 1개 안에서 논리적으로 나누는 것입니다.\n\n병렬 커넥션 (HTTP/1.1)\n  TCP 연결을 실제로 여러 개 생성\n  연결마다 3-way Handshake 비용 발생\n  연결마다 Slow Start 처음부터 다시 시작\n  서버 입장에서 연결 10개 = 10개의 독립적인 부담\n  → 성능을 위해 억지로 연결을 늘리는 꼼수\n\n멀티플렉싱 (HTTP/2)\n  TCP 연결은 딱 1개\n  그 안에서 스트림(Stream)으로 논리적으로 나눔\n  Handshake 1번, Slow Start 1번\n  스트림은 프레임에 붙은 Stream ID일 뿐 — 물리적 연결이 아님\n  → 연결 1개를 효율적으로 쓰는 방식\n\n비유\n  병렬 커넥션  →  서울-부산 고속도로를 10개 새로 깔기\n  멀티플렉싱   →  고속도로 1개에 차선을 10개 만들기"]],"language":[["Plain Text"]]},"created_time":1779436598634,"last_edited_time":1779436598634,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"8DtTP-Wpj2Gym-szJT0F8w,\"start\",\"end\"","n":{"8DtTP-Wpj2Gym-szJT0F8w,\"start\",\"end\"":{"s":{"x":"8DtTP-Wpj2Gym-szJT0F8w","i":[{"t":"s"},{"t":"t","i":["UnZNdXdwkXVv",1],"o":"start","l":455,"c":"A.\n병렬 커넥션은 TCP 연결을 여러 개 만드는 것이고,\n멀티플렉싱은 TCP 연결 1개 안에서 논리적으로 나누는 것입니다.\n\n병렬 커넥션 (HTTP/1.1)\n  TCP 연결을 실제로 여러 개 생성\n  연결마다 3-way Handshake 비용 발생\n  연결마다 Slow Start 처음부터 다시 시작\n  서버 입장에서 연결 10개 = 10개의 독립적인 부담\n  → 성능을 위해 억지로 연결을 늘리는 꼼수\n\n멀티플렉싱 (HTTP/2)\n  TCP 연결은 딱 1개\n  그 안에서 스트림(Stream)으로 논리적으로 나눔\n  Handshake 1번, Slow Start 1번\n  스트림은 프레임에 붙은 Stream ID일 뿐 — 물리적 연결이 아님\n  → 연결 1개를 효율적으로 쓰는 방식\n\n비유\n  병렬 커넥션  →  서울-부산 고속도로를 10개 새로 깔기\n  멀티플렉싱   →  고속도로 1개에 차선을 10개 만들기"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"0660de46-eb3f-485c-a5a8-6a89e15f64bc":{"value":{"value":{"id":"0660de46-eb3f-485c-a5a8-6a89e15f64bc","version":10,"type":"sub_sub_header","properties":{"title":[["Q12. Keep-Alive와 멀티플렉싱은 각각 어떤 문제를 해결하나요? ⭐"]]},"format":{"toggleable":false},"created_time":1779436598634,"last_edited_time":1779437753929,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"m89XrCU4SQgPRpzSXQ5B7Q,\"start\",\"end\"","n":{"m89XrCU4SQgPRpzSXQ5B7Q,\"start\",\"end\"":{"s":{"x":"m89XrCU4SQgPRpzSXQ5B7Q","i":[{"t":"s"},{"t":"t","i":["zujPuKThATYu",1],"o":"start","l":40,"c":"Q12. Keep-Alive와 멀티플렉싱은 각각 어떤 문제를 해결하나요?"},{"t":"t","i":["cchF-gb5PKa3",41],"o":["zujPuKThATYu",40],"l":2,"c":" ⭐"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"695bca46-727f-4972-8659-dbf2096d6d29":{"value":{"value":{"id":"695bca46-727f-4972-8659-dbf2096d6d29","version":4,"type":"code","properties":{"title":[["A.\n해결하는 문제가 서로 다릅니다.\n\nKeep-Alive (HTTP/1.1)\n  해결한 문제: TCP 연결 비용 반복\n  방식: 한 번 맺은 TCP 연결을 여러 요청에 재사용\n  → 3-way Handshake, Slow Start 비용을 매번 내지 않아도 됨\n  → 하지만 요청은 여전히 순차적 (HOL Blocking 미해결)\n\n멀티플렉싱 (HTTP/2)\n  해결한 문제: HOL Blocking\n  방식: 하나의 연결에서 여러 스트림을 동시에 처리\n  → 앞 요청이 느려도 뒤 요청이 블로킹되지 않음\n  → TCP 연결 자체를 빠르게 만드는 게 아님\n\n정리\n  Keep-Alive  →  \"연결을 재사용하자\" (TCP 비용 절약)\n  멀티플렉싱  →  \"연결 안에서 동시에 처리하자\" (HOL Blocking 해결)\n  둘은 해결하는 레이어가 다름"]],"language":[["Plain Text"]]},"created_time":1779436598634,"last_edited_time":1779436598634,"parent_id":"36823329-f081-81fa-b183-e48c58da0212","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"79a-Ko7j_3fsBZXQ0Dj4-A,\"start\",\"end\"","n":{"79a-Ko7j_3fsBZXQ0Dj4-A,\"start\",\"end\"":{"s":{"x":"79a-Ko7j_3fsBZXQ0Dj4-A","i":[{"t":"s"},{"t":"t","i":["KvhTIJFvXd_p",1],"o":"start","l":422,"c":"A.\n해결하는 문제가 서로 다릅니다.\n\nKeep-Alive (HTTP/1.1)\n  해결한 문제: TCP 연결 비용 반복\n  방식: 한 번 맺은 TCP 연결을 여러 요청에 재사용\n  → 3-way Handshake, Slow Start 비용을 매번 내지 않아도 됨\n  → 하지만 요청은 여전히 순차적 (HOL Blocking 미해결)\n\n멀티플렉싱 (HTTP/2)\n  해결한 문제: HOL Blocking\n  방식: 하나의 연결에서 여러 스트림을 동시에 처리\n  → 앞 요청이 느려도 뒤 요청이 블로킹되지 않음\n  → TCP 연결 자체를 빠르게 만드는 게 아님\n\n정리\n  Keep-Alive  →  \"연결을 재사용하자\" (TCP 비용 절약)\n  멀티플렉싱  →  \"연결 안에서 동시에 처리하자\" (HOL Blocking 해결)\n  둘은 해결하는 레이어가 다름"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}}},"collection":{},"collection_view":{},"notion_user":{},"collection_query":{},"signed_urls":{"attachment:6cd6299d-5142-4435-bc28-7905d4f38078:SocialMediaPreviewImage.png":"https://file.notion.com/f/f/42226e73-10fb-44ef-86b2-97a01d83a329/6cd6299d-5142-4435-bc28-7905d4f38078/SocialMediaPreviewImage.png?table=block&id=36823329-f081-8057-9ff2-fd7f37a861b4&spaceId=42226e73-10fb-44ef-86b2-97a01d83a329&expirationTimestamp=1790863200000&signature=JOui-lbI4xOISxEaNyKplYVq_WXbfBDoDQGFTIiQbNE"}}}