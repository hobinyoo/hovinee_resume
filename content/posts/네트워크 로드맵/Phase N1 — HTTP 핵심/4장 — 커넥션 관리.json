ck","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"BHUcS_Y7QfonxQBd-w5_2Q,\"start\",\"end\"","n":{"BHUcS_Y7QfonxQBd-w5_2Q,\"start\",\"end\"":{"s":{"x":"BHUcS_Y7QfonxQBd-w5_2Q","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"17efcadf-eca8-4c53-891e-a583a6bec23a":{"value":{"value":{"id":"17efcadf-eca8-4c53-891e-a583a6bec23a","version":3,"type":"sub_header","properties":{"title":[["4.1 TCP 커넥션"]]},"format":{"toggleable":false},"created_time":1779429505393,"last_edited_time":1779429505393,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"y758w_lQdwmoVAcNvVPrmA,\"start\",\"end\"","n":{"y758w_lQdwmoVAcNvVPrmA,\"start\",\"end\"":{"s":{"x":"y758w_lQdwmoVAcNvVPrmA","i":[{"t":"s"},{"t":"t","i":["evXQEBZExxXt",1],"o":"start","l":11,"c":"4.1 TCP 커넥션"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"d20c3ff7-7d6b-45d6-84c1-552060907d3b":{"value":{"value":{"id":"d20c3ff7-7d6b-45d6-84c1-552060907d3b","version":3,"type":"text","properties":{"title":[["HTTP는 TCP 위에서 동작한다. HTTP가 \"이 데이터 저기로 보내줘\" 하면 TCP가 실제로 전송을 책임지는 구조다."]]},"created_time":1779429505394,"last_edited_time":1779429505394,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"dZkI_kiBB-wfQiodXp4ZgA,\"start\",\"end\"","n":{"dZkI_kiBB-wfQiodXp4ZgA,\"start\",\"end\"":{"s":{"x":"dZkI_kiBB-wfQiodXp4ZgA","i":[{"t":"s"},{"t":"t","i":["VSbUE8BtDpkU",1],"o":"start","l":67,"c":"HTTP는 TCP 위에서 동작한다. HTTP가 \"이 데이터 저기로 보내줘\" 하면 TCP가 실제로 전송을 책임지는 구조다."},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"d29d422a-388a-4af4-b0c8-b0f7956906fb":{"value":{"value":{"id":"d29d422a-388a-4af4-b0c8-b0f7956906fb","version":3,"type":"code","properties":{"title":[["TCP가 HTTP한테 보장해주는 것\n\n신뢰성\n  데이터가 순서대로, 빠짐없이 도착한다는 보장\n  중간에 패킷 유실되면 TCP가 알아서 재전송\n  HTTP는 이걸 신경 안 써도 됨\n\n스트림\n  TCP는 데이터를 세그먼트 단위로 쪪싹서 IP 패킷에 담아 전송\n  받는 쪪 TCP가 다시 조립해서 HTTP에게 전달\n  HTTP 입장에서는 \"그냥 데이터 흘려보내면 알아서 도착\""]],"language":[["Plain Text"]]},"created_time":1779429505394,"last_edited_time":1779429505394,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"3CaBAnVnuMCMiHRf_JF27Q,\"start\",\"end\"","n":{"3CaBAnVnuMCMiHRf_JF27Q,\"start\",\"end\"":{"s":{"x":"3CaBAnVnuMCMiHRf_JF27Q","i":[{"t":"s"},{"t":"t","i":["VM-SXIBSGEUM",1],"o":"start","l":207,"c":"TCP가 HTTP한테 보장해주는 것\n\n신뢰성\n  데이터가 순서대로, 빠짐없이 도착한다는 보장\n  중간에 패킷 유실되면 TCP가 알아서 재전송\n  HTTP는 이걸 신경 안 써도 됨\n\n스트림\n  TCP는 데이터를 세그먼트 단위로 쪪싹서 IP 패킷에 담아 전송\n  받는 쪪 TCP가 다시 조립해서 HTTP에게 전달\n  HTTP 입장에서는 \"그냥 데이터 흘려보내면 알아서 도착\""},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"5a92069b-0b02-44fa-8dea-ed159e203732":{"value":{"value":{"id":"5a92069b-0b02-44fa-8dea-ed159e203732","version":3,"type":"code","properties":{"title":[["전송 흐름\n\nHTTP 메시지\n    ↓\nTCP가 세그먼트로 쪪싹\n    ↓\nIP 패킷에 담아서 전송\n    ↓\n상대방 TCP가 다시 조립\n    ↓\nHTTP 메시지 도착"]],"language":[["Plain Text"]]},"created_time":1779429505395,"last_edited_time":1779429505395,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"ogwtUkjLxGF1kudZdMtsrw,\"start\",\"end\"","n":{"ogwtUkjLxGF1kudZdMtsrw,\"start\",\"end\"":{"s":{"x":"ogwtUkjLxGF1kudZdMtsrw","i":[{"t":"s"},{"t":"t","i":["-jNwghiwoSaX",1],"o":"start","l":94,"c":"전송 흐름\n\nHTTP 메시지\n    ↓\nTCP가 세그먼트로 쪪싹\n    ↓\nIP 패킷에 담아서 전송\n    ↓\n상대방 TCP가 다시 조립\n    ↓\nHTTP 메시지 도착"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1b3146d8-e630-45d3-8d50-31fdf2152660":{"value":{"value":{"id":"1b3146d8-e630-45d3-8d50-31fdf2152660","version":2,"type":"divider","created_time":1779429505396,"last_edited_time":1779429505396,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"J5mFqwUylNyVPN_Ztrdzyg,\"start\",\"end\"","n":{"J5mFqwUylNyVPN_Ztrdzyg,\"start\",\"end\"":{"s":{"x":"J5mFqwUylNyVPN_Ztrdzyg","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"13789dca-a04f-4a7c-9e89-a0fc6f496094":{"value":{"value":{"id":"13789dca-a04f-4a7c-9e89-a0fc6f496094","version":3,"type":"sub_header","properties":{"title":[["4.2 TCP 성능 고려사항"]]},"format":{"toggleable":false},"created_time":1779429505396,"last_edited_time":1779429505396,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"zJyfSJ2Sc7ZH5gD-z76XRQ,\"start\",\"end\"","n":{"zJyfSJ2Sc7ZH5gD-z76XRQ,\"start\",\"end\"":{"s":{"x":"zJyfSJ2Sc7ZH5gD-z76XRQ","i":[{"t":"s"},{"t":"t","i":["wmq0WI5Sbuzi",1],"o":"start","l":15,"c":"4.2 TCP 성능 고려사항"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"90a987f1-b629-4af0-9488-6848e3eac02a":{"value":{"value":{"id":"90a987f1-b629-4af0-9488-6848e3eac02a","version":3,"type":"text","properties":{"title":[["HTTP가 느린 이유가 전부 여기 있다. TCP가 신뢰성을 보장하는 대신 치르는 비용들이다."]]},"created_time":1779429505397,"last_edited_time":1779429505397,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"c0une7Ks_37wyLgY17a1Nw,\"start\",\"end\"","n":{"c0une7Ks_37wyLgY17a1Nw,\"start\",\"end\"":{"s":{"x":"c0une7Ks_37wyLgY17a1Nw","i":[{"t":"s"},{"t":"t","i":["BXPg11aW5WiK",1],"o":"start","l":51,"c":"HTTP가 느린 이유가 전부 여기 있다. TCP가 신뢰성을 보장하는 대신 치르는 비용들이다."},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"4a9875d8-de53-41af-8252-211a96088bc7":{"value":{"value":{"id":"4a9875d8-de53-41af-8252-211a96088bc7","version":3,"type":"code","properties":{"title":[["① 3-way Handshake 지연\n\n새 TCP 연결을 맺을 때마다 반드시 거쳐야 하는 과정\n\n클라이언트 → SYN       → 서버  \"연결할게\"\n클라이언트 ← SYN + ACK ← 서버  \"OK, 나도 연결할게\"\n클라이언트 → ACK       → 서버  \"확인\"\n              ↓\n         연결 수립 완료 → 그제서야 HTTP 요청 시작\n\nSYN = Synchronize  \"나 여기 있어, 통신 시작하자\"\nACK = Acknowledge  \"네가 보난 거 잘 받았어\"\n\n문제: HTTP/1.0은 요청마다 새 TCP 연결 → 매번 handshake 비용 발생"]],"language":[["Plain Text"]]},"created_time":1779429505397,"last_edited_time":1779429505397,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"_uuTYX1KoNgfc2l-lrCdmg,\"start\",\"end\"","n":{"_uuTYX1KoNgfc2l-lrCdmg,\"start\",\"end\"":{"s":{"x":"_uuTYX1KoNgfc2l-lrCdmg","i":[{"t":"s"},{"t":"t","i":["c-hTguXlo35L",1],"o":"start","l":327,"c":"① 3-way Handshake 지연\n\n새 TCP 연결을 맺을 때마다 반드시 거쳐야 하는 과정\n\n클라이언트 → SYN       → 서버  \"연결할게\"\n클라이언트 ← SYN + ACK ← 서버  \"OK, 나도 연결할게\"\n클라이언트 → ACK       → 서버  \"확인\"\n              ↓\n         연결 수립 완료 → 그제서야 HTTP 요청 시작\n\nSYN = Synchronize  \"나 여기 있어, 통신 시작하자\"\nACK = Acknowledge  \"네가 보난 거 잘 받았어\"\n\n문제: HTTP/1.0은 요청마다 새 TCP 연결 → 매번 handshake 비용 발생"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"3f9349a3-17bf-4b11-ae24-3f88cce73681":{"value":{"value":{"id":"3f9349a3-17bf-4b11-ae24-3f88cce73681","version":3,"type":"code","properties":{"title":[["② 확인응답(ACK) 지연\n\nTCP는 데이터를 받으면 ACK를 보내야 함\n근데 작은 ACK를 매번 바로 보내면 낙비\n→ 최대 200ms 기다렸다가 모아서 전송 (지연 연속 응답 확인)\n\n문제: 이 200ms 대기가 응답을 느리게 만들는 원인 중 하나"]],"language":[["Plain Text"]]},"created_time":1779429505398,"last_edited_time":1779429505398,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"GDIWphGb7FJ2_C4d-MpC9g,\"start\",\"end\"","n":{"GDIWphGb7FJ2_C4d-MpC9g,\"start\",\"end\"":{"s":{"x":"GDIWphGb7FJ2_C4d-MpC9g","i":[{"t":"s"},{"t":"t","i":["RYcJ2Ul86vNp",1],"o":"start","l":139,"c":"② 확인응답(ACK) 지연\n\nTCP는 데이터를 받으면 ACK를 보내야 함\n근데 작은 ACK를 매번 바로 보내면 낙비\n→ 최대 200ms 기다렸다가 모아서 전송 (지연 연속 응답 확인)\n\n문제: 이 200ms 대기가 응답을 느리게 만들는 원인 중 하나"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"cabcf4e2-eee6-42b8-a405-8bf05421b09d":{"value":{"value":{"id":"cabcf4e2-eee6-42b8-a405-8bf05421b09d","version":3,"type":"code","properties":{"title":[["③ TCP 느린 시작 (Slow Start)\n\nTCP는 처음 연결하면 혼잡을 피하려고 데이터를 조금씩 보냄\n점점 속도를 올리면서 네트워크 상태를 파악\n\n새 연결\n    ↓\n처음엔 조금만 전송 (느림)\n    ↓\n문제 없으면 점점 속도 올림\n    ↓\n최대 속도 도달\n\n문제: 새 연결을 맺을 때마다 처음부터 다시 느리게 시작\n→ Keep-Alive로 연결 재사용하면 이 비용 아낄 수 있음"]],"language":[["Plain Text"]]},"created_time":1779429505399,"last_edited_time":1779429505399,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"A2RCuF55qC5PK-eqgwiLrg,\"start\",\"end\"","n":{"A2RCuF55qC5PK-eqgwiLrg,\"start\",\"end\"":{"s":{"x":"A2RCuF55qC5PK-eqgwiLrg","i":[{"t":"s"},{"t":"t","i":["bzkn6QlFQUYv",1],"o":"start","l":217,"c":"③ TCP 느린 시작 (Slow Start)\n\nTCP는 처음 연결하면 혼잡을 피하려고 데이터를 조금씩 보냄\n점점 속도를 올리면서 네트워크 상태를 파악\n\n새 연결\n    ↓\n처음엔 조금만 전송 (느림)\n    ↓\n문제 없으면 점점 속도 올림\n    ↓\n최대 속도 도달\n\n문제: 새 연결을 맺을 때마다 처음부터 다시 느리게 시작\n→ Keep-Alive로 연결 재사용하면 이 비용 아낄 수 있음"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"477aefbc-db6a-4407-892d-1acf72292fc8":{"value":{"value":{"id":"477aefbc-db6a-4407-892d-1acf72292fc8","version":3,"type":"code","properties":{"title":[["④ Nagle 알고리즘\n\n작은 패킷을 모아서 한 번에 보내는 TCP 최적화\n네트워크 효율을 높이기 위한 것\n\n문제: HTTP 입장에서는 오히려 지연 발생 가능\n→ TCP_NODELAY 옵션으로 끄기도 함"]],"language":[["Plain Text"]]},"created_time":1779429505399,"last_edited_time":1779429505399,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"fiXxLU-YL4ULJvbPKLPgqw,\"start\",\"end\"","n":{"fiXxLU-YL4ULJvbPKLPgqw,\"start\",\"end\"":{"s":{"x":"fiXxLU-YL4ULJvbPKLPgqw","i":[{"t":"s"},{"t":"t","i":["9f3FnXIPGHOY",1],"o":"start","l":113,"c":"④ Nagle 알고리즘\n\n작은 패킷을 모아서 한 번에 보내는 TCP 최적화\n네트워크 효율을 높이기 위한 것\n\n문제: HTTP 입장에서는 오히려 지연 발생 가능\n→ TCP_NODELAY 옵션으로 끄기도 함"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"312e5ce4-0523-44fe-8193-711087a227e4":{"value":{"value":{"id":"312e5ce4-0523-44fe-8193-711087a227e4","version":2,"type":"divider","created_time":1779429505400,"last_edited_time":1779429505400,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"xMqflpYEexBiBtnWgvXFMw,\"start\",\"end\"","n":{"xMqflpYEexBiBtnWgvXFMw,\"start\",\"end\"":{"s":{"x":"xMqflpYEexBiBtnWgvXFMw","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"476b6f17-ba88-4516-a840-85558d9d7ffa":{"value":{"value":{"id":"476b6f17-ba88-4516-a840-85558d9d7ffa","version":3,"type":"sub_header","properties":{"title":[["4.3 HTTP 커넥션 관리"]]},"format":{"toggleable":false},"created_time":1779429505400,"last_edited_time":1779429505400,"parent_id":"36823329-f081-81db-a917-e959274f0ce0","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"gEd4ZV2_UNhcZBuy_woTow,\"start\",\"end\"","n":{"gEd4ZV2_UNhcZBuy_woTow,\"start\",\"end\"":{"s":{"x":"gEd4ZV2_UNhcZBuy_woTow","i":[{"t":"s"},{"t":"t","i":["ypR3jsp6nJ7J",1],"o":"start","l":15,"c":"4.3 HTTP 커넥션 관리"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"555d3f22-a2bd-40dc-80e4-1b0133ac1961":{"value":{"value":{"id":"555d3f22-a2bd-40dc-80e4-1b0133ac1961","version":56,"type":"code","properties":{"title":[["Connection 헤더\n\n커넥션 관리에 주로 사용되는 헤더\n  Connection: keep-alive  → 연결 유지\n  Connection: close       → 연결 종료\n\n주의: Connection 헤더는 황 다음 중개자(프록시)에게 전달되면 안 됨\n      다음 중개자에게만 적용되는 헤더임"]],"language":[["Plain Text"]]},"created_time":1779429505400,"las