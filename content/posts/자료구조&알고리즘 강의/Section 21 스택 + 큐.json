n        }\n        return ++this.size;\n    }\n\n    dequeue(){\n        if(!this.first) return null;\n\n        var temp = this.first;\n        if(this.first === this.last) {\n            this.last = null;\n        }\n        this.first = this.first.next;\n        this.size--;\n        return temp.value;\n    }\n}"]],"language":[["JavaScript"]]},"created_time":1727061698860,"last_edited_time":1727066870284,"parent_id":"10a23329-f081-8028-858a-fc2ed9e89262","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"S1eoZCzIqMHnVGL2SIAK2w,\"start\",\"end\"","n":{"S1eoZCzIqMHnVGL2SIAK2w,\"start\",\"end\"":{"s":{"x":"S1eoZCzIqMHnVGL2SIAK2w","i":[{"t":"s"},{"t":"t","i":["scApjTt9b3-D",1],"o":"start","l":751,"c":"class Node {\n    constructor(value){\n        this.value = value;\n        this.next = null;\n    }\n}\n\nclass Queue {\n    constructor(){\n        this.first = null;\n        this.last = null;\n        this.size = 0;\n    }\n    enqueue(val){\n        var newNode = new Node(val);\n        if(!this.first){\n            this.first = newNode;\n            this.last = newNode;\n        } else {\n            this.last.next = newNode;\n            this.last = newNode;\n        }\n        return ++this.size;\n    }\n\n    dequeue(){\n        if(!this.first) return null;\n\n        var temp = this.first;\n        if(this.first === this.last) {\n            this.last = null;\n        }\n        this.first = this.first.next;\n        this.size--;\n        return temp.value;\n    }\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}}},"collection":{},"collection_view":{},"notion_user":{},"collection_query":{},"signed_urls":{"https://prod-files-secure.s3.us-west-2.amazonaws.com/42226e73-10fb-44ef-86b2-97a01d83a329/5ddc9d9b-eb5f-4f70-ad73-b1aa42204d69/SocialMediaPreviewImage.png":"https://file.notion.com/f/f/42226e73-10fb-44ef-86b2-97a01d83a329/5ddc9d9b-eb5f-4f70-ad73-b1aa42204d69/SocialMediaP