\n\nclass Stack {\n    constructor(){\n        this.first = null;\n        this.last = null;\n        this.size = 0;\n    }\n    push(val){\n        var newNode = new Node(val);\n        if(!this.first){\n            this.first = newNode;\n            this.last = newNode;\n        } else {\n            var temp = this.first;\n            this.first = newNode;\n            this.first.next = temp;\n        }\n        return ++this.size;\n    }\n    pop(){\n        if(!this.first) return null;\n        var temp = this.first;\n        if(this.first === this.last){\n            this.last = null;\n        }\n        this.first = this.first.next;\n        this.size--;\n        return temp.value;\n    }\n}"]],"language":[["JavaScript"]]},"created_time":1727060033493,"last_edited_time":1727060976818,"parent_id":"10a23329-f081-8028-858a-fc2ed9e89262","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"wZ4XaC00JD5HMhOwxCIshg,\"start\",\"end\"","n":{"wZ4XaC00JD5HMhOwxCIshg,\"start\",\"end\"":{"s":{"x":"wZ4XaC00JD5HMhOwxCIshg","i":[{"t":"s"},{"t":"t","i":["F3z107UIxuT1",1],"o":"start","l":775,"c":"class Node {\n    constructor(value){\n        this.value = value;\n        this.next = null;\n    }\n}\n\nclass Stack {\n    constructor(){\n        this.first = null;\n        this.last = null;\n        this.size = 0;\n    }\n    push(val){\n        var newNode = new Node(val);\n        if(!this.first){\n            this.first = newNode;\n            this.last = newNode;\n        } else {\n            var temp = this.first;\n            this.first = newNode;\n            this.first.next = temp;\n        }\n        return ++this.size;\n    }\n    pop(){\n        if(!this.first) return null;\n        var temp = this.first;\n        if(this.first === this.last){\n            this.last = null;\n        }\n        this.first = this.first.next;\n        this.size--;\n        return temp.value;\n    }\n}"},