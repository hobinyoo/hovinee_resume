arr[idx2], arr[idx1]];\n  };\n\n  // We are assuming the pivot is always the first element\n  let pivot = arr[start];\n  let swapIdx = start;\n\n  for (let i = start + 1; i <= end; i++) {\n    if (pivot > arr[i]) {\n      swapIdx++;\n      swap(arr, swapIdx, i);\n    }\n  }\n\n  // Swap the pivot from the start the swapPoint\n  swap(arr, start, swapIdx);\n  return swapIdx;\n}"]],"language":[["JavaScript"]]},"created_time":1726215263877,"last_edited_time":1726215283223,"parent_id":"f862f77e-e7c7-4a48-b908-8beb11eeedb8","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"PKBlkeGYGUCP7VvVxbEb6g,\"start\",\"end\"","n":{"PKBlkeGYGUCP7VvVxbEb6g,\"start\",\"end\"":{"s":{"x":"PKBlkeGYGUCP7VvVxbEb6g","i":[{"t":"s"},{"t":"t","i":["rI0wZu8pAzSQ",1],"o":"start","l":484,"c":"function pivot(arr, start = 0, end = arr.length - 1) {\n  const swap = (arr, idx1, idx2) => {\n    [arr[idx1], arr[idx2]] = [arr[idx2], arr[idx1]];\n  };\n\n  // We are assuming the pivot is always the first element\n  let pivot = arr[start];\n  let swapIdx = start;\n\n  for (let i = start + 1; i <= end; i++) {\n    if (pivot > arr[i]) {\n      swapIdx++;\n      swap(arr, swapIdx, i);\n    }\n  }\n\n  // Swap the pivot from the start the swapPoint\n  swap(arr, start, swapIdx);\n  return swapIdx;\n}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"10023329-f081-80a6-82d8-c2a3d1f13c58":{"value":{"value":{"id":"10023329-f081-80a6-82d8-c2a3d1f13c58","version":71,"type":"text","properties":{"title":[["퀵 정렬 구현",[["b"]]]]},"created_time":1726215261815,"last_edited_time":1726215311976,"parent_id":"f862f77e-e7c7-4a48-b908-8beb11eeedb8","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"X6_2KiQs_IecRPwjAoKMUA,\"start\",\"end\"","n":{"X6_2KiQs_IecRPwjAoKMUA,\"start\",\"end\"":{"s":{"x":"X6_2KiQs_IecRPwjAoKMUA","i":[{"t":"s"},{"t":"t","i":["-suYRU-d