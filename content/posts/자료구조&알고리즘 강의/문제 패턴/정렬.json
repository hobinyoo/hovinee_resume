0dSoqSsiWKtn",14],"s":{"i":["0dSoqSsiWKtn",1],"a":"b"},"e":{"i":["0dSoqSsiWKtn",13],"a":"a"},"a":["a","https://www.acmicpc.net/problem/3273"]}],"a":[]},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1e523329-f081-80c2-9049-cc1f87879141":{"value":{"value":{"id":"1e523329-f081-80c2-9049-cc1f87879141","version":19,"type":"code","properties":{"title":[["function countPairsWithSum(arr, targetSum) {\n    // 배열 정렬\n    arr.sort((a, b) => a - b);\n    \n    let count = 0;\n    let left = 0;\n    let right = arr.length - 1;\n    \n    // 양쪽 끝에서 중앙으로 이동하는 투 포인터\n    while (left < right) {\n        const sum = arr[left] + arr[right];\n        \n        if (sum === targetSum) {\n            count++;\n            left++;\n            right--;\n        } else if (sum < targetSum) {\n            left++;\n        } else {\n            right--;\n        }\n    }\n    \n    return count;\n}\n\nlet num = [5, 12, 7, 10, 9, 1, 2, 3, 11];\nconsole.log(countPairsWithSum(num, 13));"]],"language":[["JavaScript"]]},"created_time":1746001727426,"last_edited_time":1746001733341,"parent_id":"1e523329-f081-800c-a3b6-e3fdd8461b54","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"rnCp0Wxd8LqyrLfSnr_fTQ,\"start\",\"end\"","n":{"rnCp0Wxd8LqyrLfSnr_fTQ,\"start\",\"end\"":{"s":{"x":"rnCp0Wxd8LqyrLfSnr_fTQ","i":[{"t":"s"},{"t":"t","i":["sSEC92h4NDei",1],"o":"start","l":593,"c":"function countPairsWithSum(arr, targetSum) {\n    // 배열 정렬\n    arr.sort((a, b) => a - b);\n    \n    let count = 0;\n    let left = 0;\n    let right = arr.length - 1;\n    \n    // 양쪽 끝에서 중앙으로 이동하는 투 포인터\n    while (left < right) {\n        const sum = arr[left] + arr[right];\n        \n        if (sum === targetSum) {\n            count++;\n            left++;\n            right--;\n        } else if (sum < targetSum) {\n            left++;\n        } else {\n            right--;\n        }\n    }\n    \n    return count;\n}\n\nlet num = [5, 12, 7, 10, 9, 1, 2, 3, 11];\nconsole.log(countPairsWithSum(num, 13));"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}}},"collection":{},"collection_view":{},"notion_user":{},"collection_query":{},"signed_urls":{"attachment:a425538a-8fb2-41d8-85fa-2cda602925fc:SocialMediaPreviewImage.png":"https://file.notion.com/f/f/42226e73-10fb-44ef-86b2-97a01d83a329/a425538a-8fb2-41d8-85fa-2cda602925fc/SocialMediaPreviewImage.png?table=block&id=5553f013-6f87-42d6-8f6c-39faa01be192&spaceId=42226e73-10fb-44ef-86b2-97a01d83a329&expirationTimestamp=1790776800000&signature=kRqYBVfeMJ3e_c4SlRDy68ZkLaIM5iiOLOix7-3O5J8"}}}