 [[start, 0]]; // [노드, 거리]\n            colors[start] = color;\n            currentGroup.push(start);\n\n            while (queue.length > 0) {\n                const [node, dist] = queue.shift();\n\n                // 거리가 2 미만일 때만 인접 노드 탐색\n                if (dist < 2) {\n                    for (const neighbor of graph[node]) {\n                        if (colors[neighbor] === 0) { // 아직 칠하지 않은 노드만\n                            colors[neighbor] = color;\n                            currentGroup.push(neighbor);\n                            queue.push([neighbor, dist + 1]);\n                        }\n                    }\n                }\n            }\n\n            // 그룹을 정렬해서 추가\n            currentGroup.sort((a, b) => a - b);\n            groups.push(currentGroup.join(' '));\n        }\n    }\n\n    return groups;\n}\n\nconsole.log(\"=== 테스트 1 ===\");\nconst edges1 = [[1, 4], [4, 6], [2, 6], [2, 3], [3, 5], [6, 7], [5, 8]];\nconsole.log(colorGraph(8, edges1))\n\n\n"]],"language":[["JavaScript"]]},"created_time":1755477105335,"last_edited_time":1755477849053,"parent_id":"25323329-f081-80bd-a04c-cb2122d43d00","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"Nb5PQs_Jzx83hQxO6UxjkQ,\"start\",\"end\"","n":{"Nb5PQs_Jzx83hQxO6UxjkQ,\"start\",\"end\"":{"s":{"x":"Nb5PQs_Jzx83hQxO6UxjkQ","i":[{"t":"s"},{"t":"t","i":["YDxWXMiBO5Gr",2507],"o":"start","l":1512,"c":"// 문제 2: 그래프 색칠하기 (거리 2 이하는 같은 색)\nfunction colorGraph(n, edges) {\n    // 인접 리스트 생성\n    const graph = Array(n + 1).fill().map(() => []);\n    for (const [u, v] of edges) {\n        graph[u].push(v);\n        graph[v].push(u);\n    }\n\n    const colors = Array(n + 1).fill(0);\n    const groups = []; // 각 색깔별 노드 그룹\n\n    // BFS로 거리 2 이하인 노드들을 같은 색으로 칠하기\n    for (let start = 1; start <= n; start++) {\n        if (colors[start] === 0) { // 아직 칠하지 않은 노드만\n            const color = start; // 시작 노드 번호를 색깔로 사용\n            const currentGroup = [];\n            const queue = [[start, 0]]; // [노드, 거리]\n            colors[start] = color;\n            currentGroup.push(start);\n\n            while (queue.length > 0) {\n                const [node, dist] = queue.shift();\n\n                // 거리가 2 미만일 때만 인접 노드 탐색\n                if (dist < 2) {\n                    for (const neighbor of graph[node]) {\n                        if (colors[neighbor] === 0) { // 아직 칠하지 않은 노드만\n                            colors[neighbor] = color;\n                            currentGroup.push(neighbor);\n                            queue.push([neighbor, dist + 1]);\n                        }\n                    }\n                }\n            }\n\n            // 그룹을 정렬해서 추가\n            currentGroup.sort((a, b) => a - b);\n            groups.push(currentGroup.join(' '));\n        }\n    }\n\n    return groups;\n}\n\nconsole.log(\"=== 테스트 1 ===\");\nconst edges1 = [[1, 4], [4, 6], [2, 6], [2, 3], [3, 5], [6, 7], [5, 8]];\nconsole.log(colorGraph(8, edges1))\n\n\n"},{"t":"t","i":["YDxWXMiBO5Gr",1124],"o":"start","l":-1383},{"t":"t","i":["YDxWXMiBO5Gr",1],"o":"start","l":-1123},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"25323329-f081-80d0-9d63-fbec53d2f62d":{"value":{"value":{"id":"25323329-f081-80d0-9d63-fbec53d2f62d","version":82,"type":"numbered_list","properties":{"title":[["그래프 색칠하기"]]},"format":{"list_start_index":3},"created_time":1755475545791,"last_edited_time":1755477092043,"parent_id":"25323329-f081-80bd-a04c-cb2122d43d00","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"AitDzkqZFD0uxMpRGC6tIw,\"start\",\"end\"","n":{"AitDzkqZFD0uxMpRGC6tIw,\"start\",\"end\"":{"s":{"x":"AitDzkqZFD0uxMpRGC6tIw","i":[{"t":"s"},{"t":"t","i":["YDxWXMiBO5Gr",8],"o":"start","l":1,"c":"그"},{"t":"t","i":["YDxWXMiBO5Gr",11],"o":["YDxWXMiBO5Gr",8],"l":3,"c":"래프 "},{"t":"t","i":["YDxWXMiBO5Gr",16],"o":["YDxWXMiBO5Gr",13],"l":1,"c":"색"