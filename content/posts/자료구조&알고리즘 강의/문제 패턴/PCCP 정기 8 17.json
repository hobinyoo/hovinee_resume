WXMiBO5Gr",14],"l":-1},{"t":"t","i":["YDxWXMiBO5Gr",12],"o":["YDxWXMiBO5Gr",11],"l":-2},{"t":"t","i":["YDxWXMiBO5Gr",9],"o":"start","l":-2},{"t":"t","i":["YDxWXMiBO5Gr",8],"o":"start","l":-1},{"t":"t","i":["YDxWXMiBO5Gr",5],"o":"start","l":-3},{"t":"t","i":["YDxWXMiBO5Gr",3],"o":"start","l":-2},{"t":"t","i":["YDxWXMiBO5Gr",1],"o":"start","l":-2},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"25323329-f081-80d2-bf68-ccc6020694e0":{"value":{"value":{"id":"25323329-f081-80d2-bf68-ccc6020694e0","version":19,"type":"code","properties":{"title":[["function territoryGame(grid, positions) {\n    const rows = grid.length;\n    const cols = grid[0].length;\n    const occupied = Array(rows).fill().map(() => Array(cols).fill(false));\n    \n    let aScore = 0, bScore = 0;\n    let aX, aY, bX, bY;\n    \n    // 각 턴별로 게임 진행\n    for (let turn = 0; turn < positions.length; turn++) {\n        [aX, aY, bX, bY] = positions[turn];\n        \n        const size = turn + 1; // 1턴: 1x1, 2턴: 2x2, 3턴: 3x3...\n        \n        // A의 턴\n        const aCells = getSquareArea(aX, aY, size, occupied, rows, cols);\n        for (const [x, y] of aCells) {\n            occupied[x][y] = true;\n            aScore += grid[x][y];\n        }\n        \n        // B의 턴\n        const bCells = getSquareArea(bX, bY, size, occupied, rows, cols);\n        for (const [x, y] of bCells) {\n            occupied[x][y] = true;\n            bScore += grid[x][y];\n        }\n    }\n    \n    return [aScore, bScore];\n}\n\nfunction getSquareArea(startX, startY, size, occupied, rows, cols) {\n    const result = [];\n    \n    // 시작점(startX, startY)에서 오른쪽과 아래쪽으로 size x size 영역 생성\n    for (let i = 0; i < size; i++) {\n        for (let j = 0; j < size; j++) {\n            const x = startX + i;\n            const y = startY + j;\n            \n            // 범위 내에 있고 아직 점유되지 않은 칸만 추가\n            if (x >= 0 && x < rows && y >= 0 && y < cols && !occupied[x][y]) {\n                result.push([x, y]);\n            }\n        }\n    }\n    \n    return result;\n}\n\n// 테스트 예시\nconst grid1 = [\n    [1, 2, 3, 4],\n    [6, 7, 8, 9],\n    [5, 6, 7, 8],\n    [0, 1, 2, 7]\n];\n\nconst positions1 = [\n    [1, 3, 0, 0],  // 1턴: 1x1 영역\n    [1, 0, 2, 1],  // 2턴: 2x2 영역\n    [3, 2, 2, 0]   // 3턴: 3x3 영역\n];\n\nconsole.log(\"개선된 Territory Game 결과:\", territoryGame(grid1, positions1));"]],"language":[["JavaScript"]]},"created_time":1755475602139,"last_edited_time":1755476837112,"parent_id":"25323329-f081-80bd-a04c-cb2122d43d00","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"W5JbXfBB1xXlUqHN0oXXVQ,\"start\",\"end\"","n":{"W5JbXfBB1xXlUqHN0oXXVQ,\"start\",\"end\"":{"s":{"x":"W5JbXfBB1xXlUqHN0oXXVQ","i":[{"t":"s"},{"t":"t","i":["YDxWXMiBO5Gr",3894],"o":"start","l":1742,"c":"function territoryGame(grid, positions) {\n    const rows = grid.length;\n    const cols = grid[0].length;\n    const occupied = Array(rows).fill().map(() => Array(cols).fill(false));\n    \n    let aScore = 0, bScore = 0;\n    let aX, aY, bX, bY;\n    \n    // 각 턴별로 게임 진행\n    for (let turn = 0; turn < positions.length; turn++) {\n        [aX, aY, bX, bY] = positions[turn];\n        \n        const size = turn + 1; // 1턴: 1x1, 2턴: 2x2, 3턴: 3x3...\n        \n        // A의 턴\n        const aCells = getSquareArea(aX, aY, size, occupied, rows, cols);\n        for (const [x, y] of aCells) {\n            occupied[x][y] = true;\n            aScore += grid[x][y];\n        }\n        \n        // B의 턴\n        const bCells = getSquareArea(bX, bY, size, occupied, rows, cols);\n        for (const [x, y] of bCells) {\n            occupied[x][y] = true;\n            bScore += grid[x][y];\n        }\n    }\n    \n    return [aScore, bScore];\n}\n\nfunction getSquareArea(startX, startY, size, occupied, rows, cols) {\n    const result = [];\n    \n    // 시작점(startX, startY)에서 오른쪽과 아래쪽으로 size x size 영역 생성\n    for (let i = 0; i < size; i++) {\n        for (let j = 0; j < size; j++) {\n            const x = startX + i;\n            const y = startY + j;\n            \n            // 범위 내에 있고 아직 점유되지 않은 칸만 추가\n            if (x >= 0 && x < rows && y >= 0 && y < cols && !occupied[x][y]) {\n                result.push([x, y]);\n            }\n        }\n    }\n    \n    return result;\n}\n\n// 테스트 예시\nconst grid1 = [\n    [1, 2, 3, 4],\n    [6, 7, 8, 9],\n    [5, 6, 7, 8],\n    [0, 1, 2, 7]\n];\n\nconst positions1 = [\n    [1, 3, 0, 0],  // 1턴: 1x1 영역\n    [1, 0, 2, 1],  // 2턴: 2x2 영역\n    [3, 2, 2, 0]   // 3턴: 3x3 영역\n];\n\nconsole.log(\"개선된 Territory Game 결과:\", territoryGame(grid1, positions1));"},{"t":"t","i":["YDxWXMiBO5Gr",2084],"o":"start","l":-1810},{"t":"t","i":["YDxWXMiBO5Gr",1],"o":"start","l":-2083},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"25323329-f081-8001-8d16-d731cacf39e7":{"value":{"value":{"id":"25323329-f081-8001-8d16-d731cacf39e7","version":90,"type":"numbered_list","properties":{"title":[["그래프 색칠하기"]]},"format":{"list_start_index":2},"created_time":1755475561409,"last_edited_time":1755477105178,"parent_id":"25323329-f081-80bd-a04c-cb2122d43d00","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"YZhYnhxumHTNvJ65uSy5fw,\"start\",\"end\"","n":{"YZhYnhxumHTNvJ65uSy5fw,\"start\",\"end\"":{"s":{"x":"YZhYnhxumHTNvJ65uSy5fw","i":[{"t":"s"},{"t":"t","i":["YDxWXMiBO5Gr",8],"o":"start","l":1,"c":"그"},{"t":"t","i":["YDxWXMiBO5Gr",11],"o":["YDxWXMiBO5Gr",8],"l":3,"c":"래프 "},{"t":"t","i":["YDxWXMiBO5Gr",16],"o":["YDxWXMiBO5Gr",13],"l":1,"c":"색"},{"t":"t","i":["YDxWXMiBO5Gr",21],"o":["YDxWXMiBO5Gr",16],"l":1,"c":"칠"},{"t":"t","i":["YDxWXMiBO5Gr",29],"o":["YDxWXMiBO5Gr",21],"l":2,"c":"하기"},{"t":"t","i":["YDxWXMiBO5Gr",28],"o":["YDxWXMiBO5Gr",21],"l":-1},{"t":"t","i":["YDxWXMiBO5Gr",27],"o":["YDxWXMiBO5Gr",21],"l":-1},{"t":"t","i":["YDxWXMiBO5Gr",26],"o":["YDxWXMiBO5Gr",21],"l":-1},{"t":"t","i":["YDxWXMiBO5Gr",23],"o":["Y