input.trim().split('\\n');\n  const n = parseInt(lines[0]);\n  const parents = lines[1].split(' ').map(Number);\n  const deleteNode = parseInt(lines[2]);\n  \n  // 트리 구성 (노드별 자식 노드 목록)\n  const tree = Array.from({ length: n }, () => []);\n  let root = -1;\n  \n  // 부모-자식 관계 구성\n  for (let i = 0; i < n; i++) {\n    if (parents[i] === -1) {\n      root = i; // 루트 노드 찾기\n    } else {\n      tree[parents[i]].push(i); // 부모 노드에 자식 노드 추가\n    }\n  }\n  \n  // 노드 삭제 후 리프 노드 수 계산 함수\n  function countLeafNodes() {\n    if (root === deleteNode) {\n      return 0; // 루트 노드를 삭제하면 트리가 없어짐\n    }\n    \n    let leafCount = 0;\n    \n    // DFS로 트리 순회\n    function dfs(node) {\n      if (node === deleteNode) {\n        return; // 삭제할 노드와 그 자손은 건너뜀\n      }\n      \n      // 삭제 노드를 제외한 자식들\n      const validChildren = tree[node].filter(child => child !== deleteNode);\n      \n      if (validChildren.length === 0) {\n        // 유효한 자식이 없으면 리프 노드\n        leafCount++;\n        return;\n      }\n      \n      // 자식 노드들 순회\n      for (const child of validChildren) {\n        dfs(child);\n      }\n    }\n    \n    dfs(root);\n    return leafCount;\n  }\n  \n  return countLeafNodes();\n}\n\n// 테스트\nconsole.log(solution(input));\n\n// 예시 1: 기본적인 경우\nconsole.log('=== 예시 1 ===');\nconst input1 = `5\n-1 0 0 1 1\n2`;\nsolution(input1);\n"]],"language":[["JavaScript"]]},"created_time":1747728709731,"last_edited_time":1749460068358,"parent_id":"1f923329-f081-8029-988e-cb0f07d13144","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"ce4qKU866AQ-j7VAy4x_qQ,\"start\",\"end\"","n":{"ce4qKU866AQ-j7VAy4x_qQ,\"start\",\"end\"":{"s":{"x":"ce4qKU866AQ-j7VAy4x_qQ","i":[{"t":"s"},{"t":"t","i":["l4BJ9hpEjBU-",1],"o":"start","l":1312,"c":"\nfunction solution(input) {\n  const lines = input.trim().split('\\n');\n  const n = parseInt(lines[0]);\n  const parents = lines[1].split(' ').map(Number);\n  const deleteNode = parseInt(lines[2]);\n  \n  // 트리 구성 (노드별 자식 노드 목록)\n  const tree = Array.from({ length: n }, () => []);\n  let root = -1;\n  \n  // 부모-자식 관계 구성\n  for (let i = 0; i < n; i++) {\n    if (parents[i] === -1) {\n      root = i; // 루트 노드 찾기\n    } else {\n      tree[parents[i]].push(i); // 부모 노드에 자식 노드 추가\n    }\n  }\n  \n  // 노드 삭제 후 리프 노드 수 계산 함수\n  function countLeafNodes() {\n    if (root === deleteNode) {\n      return 0; // 루트 노드를 삭제하면 트리가 없어짐\n    }\n    \n    let leafCount = 0;\n    \n    // DFS로 트리 순회\n    function dfs(node) {\n      if (node === deleteNode) {\n        return; // 삭제할 노드와 그 자손은 건너뜀\n      }\n      \n      // 삭제 노드를 제외한 자식들\n      const validChildren = tree[node].filter(child => child !== deleteNode);\n      \n      if (validChildren.length === 0) {\n        // 유효한 자식이 없으면 리프 노드\n        leafCount++;\n        return;\n      }\n      \n      // 자식 노드들 순회\n      for (const child of validChildren) {\n        dfs(child);\n      }\n    }\n    \n    dfs(root);\n    return leafCount;\n  }\n  \n  return countLeafNodes();\n}\n\n// 테스트\nconsole.log(solution(input));\n\n// 예시 1: 기본적인 경우\nconsole.log('=== 예시 1 ===');\nconst input1 = `5\n-1 0 0 1 1\n2`;\nsolution(input1);\n"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1f923329-f081-8042-9ada-f65254742e26":{"value":{"value":{"id":"1f923329-f081-8042-9ada-f65254742e26","version":4,"type":"text","created_time":1747728709544,"last_edited_time":1747728709547,"parent_id":"1f923329-f081-8029-988e-cb0f07d13144","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"LwIibU9UlFH1IyCw7w6Rvg,\"start\",\"end\"","n":{"LwIibU9UlFH1IyCw7w6Rvg,\"start\",\"end\"":{"s":{"x":"LwIibU9UlFH1IyCw7w6Rvg","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1f923329-f081-80dd-857c-fab18286c836":{"value":{"value":{"id":"1f923329-f081-80dd-857c-fab18286c836","version":3,"type":"text","format":{"copied_from_pointer":{"id":"1f823329-f081-8007-bf7d