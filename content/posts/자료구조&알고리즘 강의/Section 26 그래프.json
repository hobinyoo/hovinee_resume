,"crdt_format_version":1,"crdt_data":{"title":{"r":"s0m774a2dpz_9H3DsVHLIg,\"start\",\"end\"","n":{"s0m774a2dpz_9H3DsVHLIg,\"start\",\"end\"":{"s":{"x":"s0m774a2dpz_9H3DsVHLIg","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1fb23329-f081-80a1-beac-eb099c4c2cc7":{"value":{"value":{"id":"1fb23329-f081-80a1-beac-eb099c4c2cc7","version":2198,"type":"code","properties":{"title":[["class Graph {\n    constructor() {\n        this.adjacencyList = {}\n    }\n    addVertex(vertex) {\n        if(!this.adjacencyList[vertex]) this.adjacencyList[vertex] = [] // 공백 제거\n    }\n    addEdge(v1, v2) {\n        this.adjacencyList[v1].push(v2)\n        this.adjacencyList[v2].push(v1)\n    }\n    removeEdge(vertex1, vertex2) {\n        this.adjacencyList[vertex1] = this.adjacencyList[vertex1].filter(\n            v => v !== vertex2)\n        this.adjacencyList[vertex2] = this.adjacencyList[vertex2].filter(\n            v => v !== vertex1)\n    }\n    removeVertex(vertex) {\n        while(this.adjacencyList[vertex].length) {\n            const adjacencyVertex = this.adjacencyList[vertex].pop()\n            this.removeEdge(vertex, adjacencyVertex)\t\t\t\t\t\n        }\n        delete this.adjacencyList[vertex]\n    }\n    depthFirstRecursive(start) {\n        const result = []\n        const visited = {}\n        const adjacencyList = this.adjacencyList\n        \n        (function dfs(vertex) {\n            if(!vertex) return null\n            visited[vertex] = true\n            result.push(vertex)\n            adjacencyList[vertex].forEach(neighbor => {\n                if(!visited[neighbor]) {\n                    dfs(neighbor) // return 제거\n                }\n            })\n        })(start)\n        return result\n    }\n    breadthFirst(start) {\n\t\t    const queue = [start]\n        const result = []\n        const visited = {}\n        let currentVertex\n        visited[vertex] = true\n        \n        // 꺼낼게 없어지면 멈춤\n        while(queue.length) {\n\t\t        currentVertex = queue.shift()\n\t\t        result.push(currentVertex)\n\t\t        \n\t\t        this.adjacencyList[currentVertex].forEach(neighbor => {\n\t\t\t\t        if(!visited[neighbor]) {\n\t\t\t\t\t\t       visited[neighbor] = true\n\t\t\t\t\t\t       queue.push(neighbor)\n\t\t\t\t        }\n\t\t        })\n        }\n        return result\n    }\n}\n\nconst g = new Graph()\ng.addVertex(\"A\")\ng.addVertex(\"B\")\ng.addVertex(\"C\")\ng.addVertex(\"D\")\ng.addVertex(\"E\")\ng.addVertex(\"F\")\ng.addEdge(\"A\",\"B\")\ng.addEdge(\"A\",\"C\")\ng.addEdge(\"B\",\"D\")\ng.addEdge(\"C\",\"E\")\ng.addEdge(\"D\",\"E\")\ng.addEdge(\"D\",\"F\")\ng.addEdge(\"E\",\"F\")\n\nconsole.log(g.depthFirstRecursive('A'))\n// 예상 출력: [\"A"]],"language":[["JavaScript"]]},"created_time":1747897235784,"last_edited_time":1747904468002,"parent_id":"1fb23329-f081-803f-8b71-f8a62849b9d1","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"AZHtLRuBPAznJC32FobuZA,\"start\",\"end\"","n":{"AZHtLRuBPAznJC32FobuZA,\"start\",\"end\"":{"s":{"x":"AZHtLRuBPAznJC32FobuZA","i":[{"t":"s"},{"t":"t","i":["YUgoRnFJuIn-",1],"o":"start","l":2177,"c":"class Graph {\n    constructor() {\n        this.adjacencyList = {}\n    }\n    addVertex(vertex) {\n        if(!this.adjacencyList[vertex]) this.adjacencyList[vertex] = [] // 공백 제거\n    }\n    addEdge(v1, v2) {\n        this.adjacencyList[v1].push(v2)\n        this.adjacencyList[v2].push(v1)\n    }\n    removeEdge(vertex1, vertex2) {\n        this.adjacencyList[vertex1] = this.adjacencyList[vertex1].filter(\n            v => v !== vertex2)\n        this.adjacencyList[vertex2] = this.adjacencyList[vertex2].filter(\n            v => v !== vertex1)\n    }\n    removeVertex(vertex) {\n        while(this.adjacencyList[vertex].length) {\n            const adjacencyVertex = this.adjacencyList[vertex].pop()\n            this.removeEdge(vertex, adjacencyVertex)\t\t\t\t\t\n        }\n        delete this.adjacencyList[vertex]\n    }\n    depthFirstRecursive(start) {\n        const result = []\n        const visited = {}\n        const adjacencyList = this.adjacencyList\n        \n        (function dfs(vertex) {\n            if(!vertex) return null\n            visited[vertex] = true\n            result.push(vertex)\n            adjacencyList[vertex].forEach(neighbor => {\n                if(!visited[neighbor]) {\n                    dfs(neighbor) // return 제거\n                }\n            })\n        })(start)\n        return result\n    }\n    breadthFirst(start) {\n\t\t    const queue = [start]\n        const result = []\n        const visited = {}\n        let currentVertex\n        visited[vertex] = true\n        \n        // 꺼낼게 없어지면 멈춤\n        while(queue.length) {\n\t\t        currentVertex = queue.shift()\n\t\t        result.push(currentVertex)\n\t\t        \n\t\t        this.adjacencyList[currentVertex].forEach(neighbor => {\n\t\t\t\t        if(!visited[neighbor]) {\n\t\t\t\t\t\t       visited[neighbor] = true\n\t\t\t\t\t\t       queue.push(neighbor)\n\t\t\t\t        }\n\t\t        })\n        }\n        return result\n    }\n}\n\nconst g = new Graph()\ng.addVertex(\"A\")\ng.addVertex(\"B\")\ng.addVertex(\"C\")\ng.addVertex(\"D\")\ng.addVertex(\"E\")\ng.addVertex(\"F\")\ng.addEdge(\"A\",\"B\")\ng.addEdge(\"A\",\"C\")\ng.addEdge(\"B\",\"D\")\ng.addEdge(\"C\",\"E\")\ng.addEdge(\"D\",\"E\")\ng.addEdge(\"D\",\"F\")\ng.addEdge(\"E\",\"F\")\n\nconsole.log(g.depthFirstRecursive('A'))\n// 예상 출력: [\"A"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1fb23329-f081-80f1-8994-d33bb6872505":{"value":{"value":{"id":"1fb23329-f081-80f1-8994-d33bb6872505","version":4,"type":"text","created_time":1747899009591,"last_edited_time":1747899009592,"parent_id":"1fb23329-f081-803f-8b71-f8a62849b9d1","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"GctKttxFoak_1TpZ35xlIA