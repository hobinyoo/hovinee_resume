c","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"CDgDIG5YoTlHFiEvWL7TlA,\"start\",\"end\"","n":{"CDgDIG5YoTlHFiEvWL7TlA,\"start\",\"end\"":{"s":{"x":"CDgDIG5YoTlHFiEvWL7TlA","i":[{"t":"s"},{"t":"t","i":["vaktA0-VbViF",1],"o":"start","l":230,"c":"프로젝트 루트/\n  ├── docker-compose.yml       ← Spring Boot가 자동 감지\n  ├── docker/\n  │     ├── postgre/\n  │     │     └── init.sql     ← PostgreSQL 테이블 DDL\n  │     └── mssql/\n  │           └── init.sql     ← MSSQL DB 생성 + 계정 생성\n  └── src/"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34a23329-f081-8007-b4a8-e361dd16fb6b":{"value":{"value":{"id":"34a23329-f081-8007-b4a8-e361dd16fb6b","version":2,"type":"divider","created_time":1776818630053,"last_edited_time":1776818630093,"parent_id":"34a23329-f081-8017-b470-ee76fe75dbdc","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"G07VkzD9HjaPBrcgMrycxw,\"start\",\"end\"","n":{"G07VkzD9HjaPBrcgMrycxw,\"start\",\"end\"":{"s":{"x":"G07VkzD9HjaPBrcgMrycxw","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34a23329-f081-80b2-b591-f4abbbb4b686":{"value":{"value":{"id":"34a23329-f081-80b2-b591-f4abbbb4b686","version":3,"type":"sub_header","properties":{"title":[["4. docker-compose.yml 전체"]]},"created_time":1776818630053,"last_edited_time":1776818630093,"parent_id":"34a23329-f081-8017-b470-ee76fe75dbdc","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"PazTen5AqoyYTDdWzIxgwA,\"start\",\"end\"","n":{"PazTen5AqoyYTDdWzIxgwA,\"start\",\"end\"":{"s":{"x":"PazTen5AqoyYTDdWzIxgwA","i":[{"t":"s"},{"t":"t","i":["NtT26-m-J0tn",1],"o":"start","l":24,"c":"4. docker-compose.yml 전체"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34a23329-f081-8054-b1b7-d1b348695969":{"value":{"value":{"id":"34a23329-f081-8054-b1b7-d1b348695969","version":3,"type":"code","properties":{"title":[["# 로컬 개발 환경 Docker Compose\n# Spring Boot 실행 시 자동으로 컨테이너 시작/종료\nname: kr-mcp-collector-sb\n\nservices:\n  postgres:\n    image: postgres:14\n    container_name: mcp-local-postgres\n    restart: unless-stopped\n    ports:\n      # 127.0.0.1 바인딩으로 로컬에서만 접근 가능 (보안 강화)\n      - \"127.0.0.1:5432:5432\"\n    environment:\n      POSTGRES_DB: mcpdb\n      POSTGRES_USER: mcp\n      POSTGRES_PASSWORD: mcp1234\n    volumes:\n      # 컨테이너 종료 후에도 데이터 유지\n      - mcp_postgres_data:/var/lib/postgresql/data\n      # 컨테이너 시작 시 init.sql 자동 실행하여 테이블 생성\n      - ./docker/postgre/init.sql:/docker-entrypoint-initdb.d/init.sql\n    # DB가 실제로 준비됐는지 확인\n    # Spring Boot가 DB 준비 완료 후 연결하도록 보장\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U mcp -d mcpdb\"]\n      interval: 5s\n      timeout: 3s\n      retries: 20\n\n  redis:\n    image: redis:7\n    container_name: mcp-local-redis\n    restart: unless-stopped\n    ports:\n      - \"127.0.0.1:6000:6379\"\n    # 비밀번호 없이 실행 (로컬 개발 환경)\n    command: redis-server --requirepass \"\"\n    healthcheck:\n      test: [\"CMD-SHELL\", \"redis-cli ping | grep -q PONG\"]\n      interval: 3s\n      timeout: 3s\n      retries: 20\n\n  mssql:\n    image: mcr.microsoft.com/mssql/server:2019-latest\n    container_name: mcp-local-mssql\n    restart: unless-stopped\n    ports:\n      - \"127.0.0.1:1433:1433\"\n    environment:\n      # MSSQL 최고 관리자 계정 비밀번호 (대문자+숫자+특수문자 필수)\n      SA_PASSWORD: \"Mcp1234!!\"\n      # Microsoft 라이선스 동의 (없으면 컨테이너 실행 안 됨)\n      ACCEPT_EULA: \"Y\"\n    volumes:\n      # 컨테이너 종료 후에도 데이터 유지\n      - mcp_mssql_data:/var/opt/mssql\n      # init.sql을 컨테이너 안으로 복사\n      - ./docker/mssql/init.sql:/init.sql\n    # MSSQL은 PostgreSQL과 달리 init.sql 자동 실행 기능 없음\n    # 서버 준비 완료 확인 후 직접 init.sql 실행\n    # 2019 버전 sqlcmd 경로: /opt/mssql-tools18/bin/sqlcmd\n    command: >\n      /bin/bash -c \"\n      /opt/mssql/bin/sqlservr &\n      until /opt/mssql-tools18/bin/sqlcmd -S localhost -U SA -P 'Mcp1234!!' -Q 'SELECT 1' > /dev/null 2>&1;\n      do\n        echo 'MSSQL 준비 중...'\n        sleep 2\n      done &&\n      /opt/mssql-tools18/bin/sqlcmd -S localhost -U SA -P 'Mcp1234!!' -i /init.sql &&\n      wait\"\n    healthcheck:\n      test: [\"CMD-SHELL\", \"/opt/mssql-tools18/bin/sqlcmd -S localhost -U SA -P 'Mcp1234!!' -Q 'SELECT 1'\"]\n      interval: 5s\n      timeout: 3s\n      retries: 20\n\nvolumes:\n  mcp_postgres_data:\n  mcp_mssql_data:"]],"language":[["YAML"]]},"format":{"code_wrap":true},"created_time":1776818630053,"last_edited_time":1776818630093,"parent_id":"34a23329-f081-8017-b470-ee76fe75dbdc","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"JRgTH85zkUfb1usCS12vdw,\"start\",\"end\"","n":{"JRgTH85zkUfb1usCS12vdw,\"start\",\"end\"":{"s":{"x":"JRgTH85zkUfb1usCS12vdw","i":[{"t":"s"},{"t":"t","i":["yqN3sCuYVN8X",1],"o":"start","l":2303,"c":"# 로컬 개발 환경 Docker Compose\n# Spring Boot 실행 시 자동으로 컨테이너 시작/종료\nname: kr-mcp-collector-sb\n\nservices:\n  postgres:\n    image: postgres:14\n    container_name: mcp-local-postgres\n    restart: unless-stopped\n    ports:\n      # 127.0.0.1 바인딩으로 로컬에서만 접근 가능 (보안 강화)\n      - \"127.0.0.1:5432:5432\"\n    environment:\n      POSTGRES_DB: mcpdb\n      POSTGRES_USER: mcp\n      POSTGRES_PASSWORD: mcp1234\n    volumes:\n      # 컨테이너 종료 후에도 데이터 유지\n      - mcp_postgres_data:/var/lib/postgresql/data\n      # 컨테이너 시작 시 init.sql 자동 실행하여 테이블 생성\n      - ./docker/postgre/init.sql:/docker-entrypoint-initdb.d/init.sql\n    # DB가 실제로 준비됐는지 확인\n    # Spring Boot가 DB 준비 완료 후 연결하도록 보장\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U mcp -d mcpdb\"]\n      interval: 5s\n      timeout: 3s\n      retries: 20\n\n  redis:\n    image: redis:7\n    container_name: mcp-local-redis\n    restart: unless-stopped\n    ports:\n      - \"127.0.0.1:6000:6379\"\n    # 비밀번호 없이 실행 (로컬 개발 환경)\n    command: redis-server --requirepass \"\"\n    healthcheck:\n      test: [\"CMD-SHELL\", \"redis-cli ping | grep -q PONG\"]\n      interval: 3s\n      timeout: 3s\n      retries: 20\n\n  mssql:\n    image: mcr.microsoft.com/mssql/server:2019-latest\n    container_name: mcp-local-mssql\n    restart: unless-stopped\n    ports:\n      - \"127.0.0.1:1433:1433\"\n    environment:\n      # MSSQL 최고 관리자 계정 비밀번호 (대문자+숫자+특수문자 필수)\n      SA_PASSWORD: \"Mcp1234!!\"\n      # Microsoft 라이선스 동의 (없으면 컨테이너 실행 안 됨)\n      ACCEPT_EULA: \"Y\"\n    volumes:\n      # 컨테이너 종료 후에도 데이터 유지\n      - mcp_mssql_data:/var/opt/mssql\n      # init.sql을 컨테이너 안으로 복사\n      - ./docker/mssql/init.sql:/init.sql\n    # MSSQL은 PostgreSQL과 달리 init.sql 자동 실행 기능 없음\n    # 서버 준비 완료 확인 후 직접 init.sql 실행\n    # 2019 버전 sqlcmd 경로: /opt/mssql-tools18/bin/sqlcmd\n    command: >\n      /bin/bash -c \"\n      /opt/mssql/bin/sqlservr &\n      until /opt/mssql-tools18/bin/sqlcmd -S localhost -U SA -P 'Mcp1234!!' -Q 'SELECT 1' > /dev/null 2>&1;\n      do\n        echo 'MSSQL 준비 중...'\n        sleep 2\n      done &&\n      /opt/mssql-tools18/bin/sqlcmd -S localhost -U SA -P 'Mcp1234!!' -i /init.sql &&\n      wait\"\n    healthcheck:\n      test: [\"CMD-SHELL\", \"/opt/mssql-tools18/bin/sqlcmd -S localhost -U SA -P 'Mcp1234!!' -Q 'SELECT 1'\"]\n      interval: 5s\n      timeout: 3s\n      retries: 20\n\nvolumes:\n  mcp_postgres_data:\n  mcp_mssql_data:"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"34a23329-f081-8074-ab1b-cf9c8a4509d7":{"value":{"value":{"id":"34a23329-f081-8074-ab1b-cf9c8a4509d7","version":2,"type":"divider","created_time":1776818630054,"last_edited_time":1776818630093,"parent_id":"34a23329-f081-8017-b470-ee76fe75dbdc","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"qMURpoQwR1DArH_QzCB9Xw,\"start\",\"end\"","n":{"qMURpoQwR1DArH_QzCB9Xw,\"start\",\"end\"":{"s":{"x":"qMURpoQwR1DArH_QzCB9Xw","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}