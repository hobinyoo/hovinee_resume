ersion":3,"type":"text","created_time":1742187542223,"last_edited_time":1742187542224,"parent_id":"1a823329-f081-8075-bed6-cd5ced122695","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329"},"role":"reader"}},"1b923329-f081-8066-bf2d-d641e57315bd":{"value":{"value":{"id":"1b923329-f081-8066-bf2d-d641e57315bd","version":244,"type":"text","properties":{"title":[["Step 2. 유효성 검증을 통해 실패시 false return"]]},"created_time":1742187457083,"last_edited_time":1742187558562,"parent_id":"1a823329-f081-8075-bed6-cd5ced122695","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329"},"role":"reader"}},"1b923329-f081-807e-88a1-e0b18e0cf15a":{"value":{"value":{"id":"1b923329-f081-807e-88a1-e0b18e0cf15a","version":46,"type":"code","properties":{"title":[["const email = formData.get('email') as string\nconst password = formData.get('password') as string\n\nif (!email || !isEmail(email)) {\n  return {\n    message: '유효한 이메일 주소를 입력해주세요.',\n    success: false,\n  }\n}\n\nif (!password || !hasMinLength(password, 6)) {\n  return {\n    message:\n      '유효한 (문자, 숫자, 특수문자 조합 6자리 이상) 비밀번호를 입력해주세요.',\n    success: false,\n  }\n}\n"]],"language":[["TypeScript"]]},"created_time":1742187528726,"last_edited_time":1742187535258,"parent_id":"1a823329-f081-8075-bed6-cd5ced122695","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329"},"role":"reader"}},"1b923329-f081-8098-8fee-d1bc40d0a5b6":{"value":{"value":{"id":"1b923329-f081-8098-8fee-d1bc40d0a5b6","version":3,"type":"text","created_time":1742187561322,"last_edited_time":1742187561323,"parent_id":"1a823329-f081-8075-bed6-cd5ced122695","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329"},"role":"reader"}},"1b923329-f081-80ce-832f-cc12644b2fd5":{"value":{"value":{"id":"1b923329-f081-80ce-832f-cc12644b2fd5","version":207,"type":"text","properties":{"title":[["Step 3. UseEffect로 메시지가  실패인 경우 포커싱"]]},"created_time":1742187560500,"last_edited_time":1742187620475,"parent_id":"1a823329-f081-8075-bed6-cd5ced122695","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329"},"role":"reader"}},"1b923329-f081-804f-95fc-f03086fd5e27":{"value":{"value":{"id":"1b923329-f081-804f-95fc-f03086fd5e27","version":624,"type":"text","properties":{"title":[["로그인 버튼 로직은 서버컴포넌트에서 실행되기 때문에 useEffect로 상태의 의존성 주입"]]},"created_time":1742187622895,"last_edited_time":1742188203844,"parent_id":"1a823329-f081-8075-bed6-cd5ced122695","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329"},"role":"reader"}},"1b923329-f081-80b8-a7f9-fe1472f228a4":{"value":{"value":{"id":"1b923329-f081-80b8-a7f9-fe1472f228a4","version":40,"type":"code","properties":{"title":[["useEffect(() => {\nif (!focusOnError) return\n\nif (\n  state.message?.includes('이메일') ||\n  (state.message?.includes('유저') && focusOnError)\n) {\n  alert(state.message)\n  emailRef.current?.focus()\n} else if (state.message?.includes('비밀번호') && focusOnError) {\n  alert(state.message)\n  passwordRef.current?.focus()\n}\n\nsetFocusOnError(false)\n}, [state.message, focusOnError])\n"]],"language":[["TypeScript"]]},"created_time":1742187578066,"last_edited_time":1742187588954,"parent_id":"1a823329-f081-8075-bed6-cd5ced122695","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329"},"role":"reader"}},"1b923329-f081-80c6-9cfc-e330c65eb00f":{"value":{"value":{"id":"1b923329-f081-80c6-9cfc-e330c65eb00f","version":9,"type":"text","properties":{"title":[["‣",[["lm",{"href":"https://reactnext-central.xyz/blog/nextjs/nextjs-15x-versionup-server-action","title":"Next.js 15에서 강화된 Server Actions 보안 살펴보기","icon_url":"https://reactnext-central.xyz/static/favicons/apple-touch-icon.png","description":"Dead Code Elimination, 안전한 Action ID 생성, 클로저 변수 암호화, Origin 검사 등 Next.js 15에서 새롭게 강화된 Server Actions 보안 방식을 자세히 살펴보고 실제 코드 예시를 통해 안전한 서버 로직 설계 방법을 안내합니다.","link_author":"Pax Code","link_provider":"N