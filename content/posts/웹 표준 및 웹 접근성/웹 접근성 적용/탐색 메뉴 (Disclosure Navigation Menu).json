보드만으로도 사용할 수 있어야 한다."},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1a723329-f081-8099-b175-f97099b7674d":{"value":{"value":{"id":"1a723329-f081-8099-b175-f97099b7674d","version":9,"type":"text","properties":{"title":[["‣",[["lm",{"href":"https://www.w3.org/WAI/ARIA/apg/patterns/disclosure/examples/disclosure-navigation/","title":"Example Disclosure Navigation Menu","icon_url":"https://www.w3.org/favicon.ico","description":"Accessibility resources free online from the international standards organization: W3C Web Accessibility Initiative (WAI).","link_author":"W3C Web Accessibility Initiative (WAI)","link_provider":"Web Accessibility Initiative (WAI)","thumbnail_url":"https://www.w3.org/WAI/assets/images/social-sharing-default.jpg"}]]]]},"created_time":1740643225097,"last_edited_time":1740643293254,"parent_id":"1a723329-f081-8025-9204-cfc2279d0bb2","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"QvO8nVfP3MUN4SU6IQ1SCA,\"start\",\"end\"","n":{"QvO8nVfP3MUN4SU6IQ1SCA,\"start\",\"end\"":{"s":{"x":"QvO8nVfP3MUN4SU6IQ1SCA","i":[{"t":"s"},{"t":"t","i":["esvBOVwXqCCR",1],"o":"start","l":1,"c":"‣","b":[{"t":"a","x":"QvO8nVfP3MUN4SU6IQ1SCA","l":"","i":["esvBOVwXqCCR",2],"s":{"i":["esvBOVwXqCCR",1],"a":"b"},"e":{"i":["esvBOVwXqCCR",1],"a":"a"},"a":["lm",{"href":"https://www.w3.org/WAI/ARIA/apg/patterns/disclosure/examples/disclosure-navigation/","title":"Example Disclosure Navigation Menu","icon_url":"https://www.w3.org/favicon.ico","description":"Accessibility resources free online from the international standards organization: W3C Web Accessibility Initiative (WAI).","link_author":"W3C Web Accessibility Initiative (WAI)","link_provider":"Web Accessibility Initiative (WAI)","thumbnail_url":"https://www.w3.org/WAI/assets/images/social-sharing-default.jpg"}]}],"a":[]},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1a723329-f081-8009-b771-cccdc4a75338":{"value":{"value":{"id":"1a723329-f081-8009-b771-cccdc4a75338","version":16,"type":"code","properties":{"title":[["'use client'\n\n/**\n* 웹 접근성을 준수한 네비게이션 바 컴포넌트\n* \n* @description 메가메뉴와 키보드 탐색을 지원하는 네비게이션 컴포넌트\n* \n* @component Navbar\n* \n* @param {Object} props\n* @param {Menu[]} props.tabs - 네비게이션 메뉴 항목들\n* @param {'main' | 'top'} [props.role='main'] - 네비게이션 역할\n* @param {MenuState} [props.menuState] - 메가메뉴 상태\n* @param {string} [props.className] - 추가 스타일 클래스\n* \n* @aria\n* - aria-expanded: 메가메뉴의 열림/닫힘 상태\n* - aria-haspopup: 하위 메뉴 존재 여부\n* \n* @keyboard\n* - Tab/Shift+Tab: 메뉴 항목 간 이동\n* - Enter: 메뉴 항목 선택/링크 이동\n* - Escape: 메가메뉴 닫기 (미구현)\n* - Arrow Keys: 메가메뉴 내부 이동 (미구현)\n* \n* @focus\n* - tabIndex={-1}: 컨테이너 포커스 제외\n* - tabIndex={menuState.isOpen ? 0 : -1}: 조건부 포커스\n* - onBlur: 메뉴 영역 이탈 시 닫기\n* \n* @todo\n* - 키보드 화살표 네비게이션 추가\n* - Escape 키 핸들링 추가\n* - ARIA role 속성 추가 (menubar, menuitem)\n* - 메가메뉴 aria-labelledby 연결\n* \n* @returns {JSX.Element} Navbar 컴포넌트\n*/\n\nimport clsx from 'clsx'\nimport NavLink from './NavLink'\nimport { Menu } from '@/types/header'\nimport { MenuState } from '@/layouts/headers/Header01'\nimport Link from 'next/link'\n\ninterface NavbarProps {\n  role?: 'main' | 'top'\n  tabs: Menu[]\n  menuState?: MenuState\n  className?: string\n  onMouseEnter?: (index: number) => void\n  onMouseLeave?: () => void\n  onFocus?: (index: number) => void\n  onBlur?: (index: number) => void\n}\n\nconst Navbar = ({\n  tabs,\n  role = 'main',\n  menuState,\n  className,\n  onMouseEnter,\n  onMouseLeave,\n  onFocus,\n}: NavbarProps) => {\n  const handleBlur = (e: React.FocusEvent) => {\n    const currentTarget = e.currentTarget\n    const relatedTarget = e.relatedTarget as HTMLElement\n    if (!currentTarget.contains(relatedTarget)) {\n      onMouseLeave?.()\n    }\n  }\n\n  return (\n    <nav>\n      <ul\n        className=\"flex\"\n        tabIndex={-1}\n        id={role === 'main' ? 'primary-nav' : 'top-nav'}\n      >\n        {tabs.map(({ title, path, megamenu }, index) => (\n          <li\n            key={index}\n            className={clsx(\n              'h-full',\n              index > 0 && 'before-pipe',\n              role === 'main' && index > 0 && 'before:mx-8',\n              role === 'main'\n                ? 'text-2xl font-bold before:h-[14px] hover:text-purple-800'\n                : 'text-lg before:mx-2 before:h-[10px]',\n              className,\n            )}\n            onMouseEnter={() => onMouseEnter?.(index)}\n            onMouseLeave={onMouseLeave}\n            onFocus={() => onFocus?.(index)}\n            onBlur={(e) => handleBlur(e)}\n          >\n            <NavLink\n              href={path}\n              aria-expanded={\n                menuState?.isOpen && menuState.activeIndex === index\n              }\n              aria-haspopup={!!megamenu}\n            >\n              {title}\n            </NavLink>\n\n            {megamenu &&\n              menuState?.isOpen &&\n              index === menuState?.activeIndex && (\n                <div\n                  className={clsx(\n                    'absolute top-full z-20 h-[35rem] w-full border-t border-gray-300 bg-white py-[3rem] transition ease-in',\n                    menuState?.isOpen\n                      ? 'visible opacity-100'\n                      : 'invisible opacity-0',\n                  )}\n                >\n                  <div className=\"container flex gap-12\">\n                    {megamenu?.map(({ title, submenu }, index) => (\n                      <ul key={index}>\n                        <p className=\"mb-4 text-2xl\">{title}</p>\n                        {submenu.slice(2)?.map(({ title, id }, index) => (\n                          <li\n                            className=\"mt-2 text-xl text-gray-400\"\n                            key={index}\n                          >\n                            <Link\n                              href={`/?categoryId=${id}`}\n                              tabIndex={menuState.isOpen ? 0 : -1}\n                            >\n                              {title}\n                            </Link>\n                          </li>\n                        ))}\n                      </ul>\n                    ))}\n                  </div>\n                </div>\n              )}\n          </li>\n        ))}\n      </ul>\n    </nav>\n  )\n}\nexport default Navbar\n"]],"language":[["TypeScript"]]},"created_time":1740643293025,"last_edited_time":1742200065634,"parent_id":"1a723329-f081-8025-9204-cfc2279d0bb2","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"SYjEFv0nR0obXVYQWtvbsg,\"start\",\"end\"","n":{"SYjEFv0nR0obXVYQWtvbsg,\"start\",\"end\"":{"s":{"x":"SYjEFv0nR0obXVYQWtvbsg","i":[{"t":"s"},{"t":"t","i":["9LFIKNJKL7ig",1],"o":"start","l":4133,"c":"'use client'\n\n/**\n* 웹 접근성을 준수한 네비게이션 바 컴포넌트\n* \n* @description 메가메뉴와 키보드 탐색을 지원하는 네비게이션 컴포넌트\n* \n* @component Navbar\n* \n* @param {Object} props\n* @param {Menu[]} props.tabs - 네비게이션 메뉴 항목들\n* @param {'main' | 'top'} [props.role='main'] - 네비게이션 역할\n* @param {MenuState} [props.menuState] - 메가메뉴 상태\n* @param {string} [props.className] - 추가 스타일 클래스\n* \n* @aria\n* - aria-expanded: 메가메뉴의 열림/닫힘 상태\n* - aria-haspopup: 하위 메뉴 존재 여부\n* \n* @keyboard\n* - Tab/Shift+Tab: 메뉴 항목 간 이동\n* - Enter: 메뉴 항목 선택/링크 이동\n* - Escape: 메가메뉴 닫기 (미구현)\n* - Arrow Keys: 메가메뉴 내부 이동 (미구현)\n* \n* @focus\n* - tabIndex={-1}: 컨테이너 포커스 제외\n* - tabIndex={menuState.isOpen ? 0 : -1}: 조건부 포커스\n* - onBlur: 메뉴 영역 이탈 시 닫기\n* \n* @todo\n* - 키보드 화살표 네비게이션 추가\n* - Escape 키 핸들링 추가\n* - ARIA role 속성 추가 (menubar, menuitem)\n* - 메가메뉴 aria-labelledby 연결\n* \n* @returns {JSX.Element} Navbar 컴포넌트\n*/\n\nimport clsx from 'clsx'\nimport NavLink from './NavLink'\nimport { Menu } from '@/types/header'\nimport { MenuState } from '@/layouts/headers/Header01'\nimport Link from 'next/link'\n\ninterface NavbarProps {\n  role?: 'main' | 'top'\n  tabs: Menu[]\n  menuState?: MenuState\n  className?: string\n  onMouseEnter?: (index: number) => void\n  onMouseLeave?: () => void\n  onFocus?: (index: number) => void\n  onBlur?: (index: number) => void\n}\n\nconst Navbar = ({\n  tabs,\n  role = 'main',\n  menuState,\n  className,\n  onMouseEnter,\n  onMouseLeave,\n  onFocus,\n}: NavbarProps) => {\n  const handleBlur = (e: React.FocusEvent) => {\n    const currentTarget = e.currentTarget\n    const relatedTarget = e.relatedTarget as HTMLElement\n    if (!currentTarget.contains(relatedTarget)) {\n      onMouseLeave?.()\n    }\n  }\n\n  return (\n    <nav>\n      <ul\n        className=\"flex\"\n        tabIndex={-1}\n        id={role === 'main' ? 'primary-nav' : 'top-nav'}\n      >\n        {tabs.map(({ title, path, megamenu }, index) => (\n          <li\n            key={index}\n            className={clsx(\n              'h-full',\n              index > 0 && 'before-pipe',\n              role === 'main' && index > 0 && 'before:mx-8',\n              role === 'main'\n                ? 'text-2xl font-bold before:h-[14px] hover:text-purple-800'\n                : 'text-lg before:mx-2 before:h-[10px]',\n              className,\n            )}\n            onMouseEnter={() => onMouseEnter?.(index)}\n            onMouseLeave={onMouseLeave}\n            onFocus={() => onFocus?.(index)}\n            onBlur={(e) => handleBlur(e)}\n          >\n            <NavLink\n              href={path}\n              aria-expanded={\n                menuState?.isOpen && menuState.activeIndex === index\n              }\n              aria-haspopup={!!megamenu}\n            >\n              {title}\n            </NavLink>\n\n            {megamenu &&\n              menuState?.isOpen &&\n              index === menuState?.activeIndex && (\n                <div\n                  className={clsx(\n                    'absolute top-full z-20 h-[35rem] w-full border-t border-gray-300 bg-white py-[3rem] transition ease-in',\n                    menuState?.isOpen\n                      ? 'visible opacity-100'\n                      : 'invisible opacity-0',\n                  )}\n                >\n                  <div className=\"container flex gap-12\">\n                    {megamenu?.map(({ title, submenu }, index) => (\n                      <ul key={index}>\n                        <p className=\"mb-4 text-2xl\">{title}</p>\n                        {submenu.slice(2)?.map(({ title, id }, index) => (\n                          <li\n                            className=\"mt-2 text-xl text-gray-400\"\n                            key={index}\n                          >\n                            <Link\n                              href={`/?categoryId=${id}`}\n                              tabIndex={menuState.isOpen ? 0 : -1}\n                            >\n                              {title}\n                            </Link>\n                          </li>\n                        ))}\n                      </ul>\n                    ))}\n                  </div>\n                </div>\n              )}\n          </li>\n        ))}\n      </ul>\n    </nav>\n  )\n}\nexport default Navbar\n"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}}},"collection":{},"collection_view":{},"notion_user":{},"collection_query":{},"signed_urls":{"attachment:eecbf570-7cae-412e-bec8-1875176c1bd3:SocialMediaPreviewImage.png":"https://file.notion.com/f/f/42226e73-10fb-44ef-86b2-97a01d83a329/eecbf570-7cae-412e-bec8-1875176c1bd3/SocialMediaPreviewImage.png?table=block&id=a47d879a-e585-4088-a2ba-9bb66e9412ca&spaceId=42226e73-10fb-44ef-86b2-97a01d83a329&expirationTimestamp=1790863200000&signature=389_XoinCZ148N8h9xdkhWdl9Nr6CNtNyYmqUH6lfl8"}}}