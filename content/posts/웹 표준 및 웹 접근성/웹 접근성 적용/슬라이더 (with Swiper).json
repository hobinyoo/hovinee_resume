ve":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"Z8ZUVa2oRoEznEwPGgkTlg,\"start\",\"end\"","n":{"Z8ZUVa2oRoEznEwPGgkTlg,\"start\",\"end\"":{"s":{"x":"Z8ZUVa2oRoEznEwPGgkTlg","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1ad23329-f081-80d9-bc5d-c1761d338a34":{"value":{"value":{"id":"1ad23329-f081-80d9-bc5d-c1761d338a34","version":5,"type":"code","properties":{"title":[["'use client'\n\n// Import Swiper React components\nimport { Swiper, SwiperSlide } from 'swiper/react'\nimport SwiperCore from 'swiper'\nimport { Navigation, Pagination, A11y } from 'swiper/modules'\n\n// Import Swiper styles\nimport 'swiper/css'\n\nimport {\n  ReactNode,\n  useMemo,\n  useState,\n  useRef,\n  useCallback,\n  useEffect,\n} from 'react'\nimport clsx from 'clsx'\nimport { LeftArrowSliderSVG, RightArrowSliderSVG } from '@/assets/icon'\n\nconst generateUniqueId = (prefix: string) =>\n  `${prefix}-${Math.random().toString(36).substr(2, 6)}`\n\ninterface SwiperSliderProps {\n  children: ReactNode\n  title?: string // 캐러셀 제목 추가\n  slidesPerView?: number\n  spaceBetween?: number\n  className?: string\n}\n\n/**\n * 웹 접근성 가이드라인을 준수한 Swiper 슬라이더 컴포넌트\n *\n * 접근성 구현 가이드라인:\n * 1. 자동 재생 제외 (이 컴포넌트에서는 구현하지 않음)\n * 2. Tab 및 Shift+Tab 키 이동: 자연스러운 탭 순서 유지\n * 3. 버튼 요소의 키보드 상호작용: Enter/Space 키 지원\n * 4. 컨트롤 버튼의 위치: 캐러셀 내용보다 먼저 배치\n * 5. 슬라이드 선택기: 필요에 따라 접근성 지원\n */\nconst SwiperSlider = ({\n  children,\n  title = '강좌 슬라이더',\n  slidesPerView = 4,\n  spaceBetween = 24,\n  className,\n}: SwiperSliderProps) => {\n  // 모듈 포함 - A11y 모듈 추가\n  SwiperCore.use([Navigation, Pagination, A11y])\n\n  // 슬라이더 상태 관리\n  const [isEnd, setIsEnd] = useState<boolean>(false)\n  const [isBeginning, setIsBeginning] = useState<boolean>(true)\n  const [activeSlideIndex, setActiveSlideIndex] = useState<number>(0)\n  const [totalSlides, setTotalSlides] = useState<number>(0)\n\n  const swiperRef = useRef<SwiperCore | null>(null)\n  const uniqueId = useRef(generateUniqueId('slider')).current\n  const titleId = useRef(generateUniqueId('title')).current\n  const swiperId = useRef(generateUniqueId('swiper-container')).current\n\n  const prevClass = `prev-swiper-nav-${uniqueId}`\n  const nextClass = `next-swiper-nav-${uniqueId}`\n\n  const updateInertAttribute = useCallback((swiper: SwiperCore) => {\n    swiper.slides.forEach((slide, index) => {\n      const isVisible =\n        index >= swiper.activeIndex && index < swiper.activeIndex + 4\n      if (isVisible) {\n        slide.removeAttribute('inert')\n        slide.setAttribute('aria-hidden', 'false')\n      } else {\n        slide.setAttribute('inert', '')\n        slide.setAttribute('aria-hidden', 'true')\n      }\n    })\n  }, [])\n\n  const option = useMemo(() => {\n    return {\n      spaceBetween,\n      slidesPerView,\n      modules: [Pagination, Navigation, A11y],\n      navigation: {\n        nextEl: clsx('.' + nextClass),\n        prevEl: clsx('.' + prevClass),\n      },\n      onSwiper: (swiper: SwiperCore) => {\n        swiperRef.current = swiper\n        setTotalSlides(swiper.slides.length)\n      },\n      onInit: (swiper: SwiperCore) => {\n        updateInertAttribute(swiper)\n      },\n      onSlideChange: (swiper: SwiperCore) => {\n        updateInertAttribute(swiper)\n        setActiveSlideIndex(swiper.activeIndex)\n        setIsBeginning(swiper.isBeginning)\n        setIsEnd(swiper.isEnd)\n      },\n      // 가이드라인 #2: 접근성 개선을 위한 A11y 옵션 설정\n      a11y: {\n        enabled: true,\n        containerMessage: title,\n        containerRoleDescriptionMessage: 'carousel',\n        itemRoleDescriptionMessage: 'slide',\n      },\n    }\n  }, [slidesPerView, spaceBetween, title])\n\n  return (\n    <div className={clsx('nav-style', className)} aria-labelledby={titleId}>\n      <h2 id={titleId} className=\"sr-only\">\n        {title}\n      </h2>\n\n      {/* 가이드라인 #2 & #4: 컨트롤을 캐러셀 앞에 배치하여 탭 순서 개선 \n          키보드 사용자가 콘텐츠 탐색 전에 컨트롤에 접근할 수 있도록 함 */}\n      <div className=\"swiper-controls\">\n        <button\n          type=\"button\"\n          className={clsx(\n            'swiper-btn swiper-btn-prev',\n            prevClass,\n            isBeginning ? 'opacity-35' : 'opacity-100',\n          )}\n          aria-label={`이전 슬라이드, 현재 ${activeSlideIndex + 1}번 슬라이드, 전체 ${totalSlides}개`}\n          aria-controls={swiperId}\n          disabled={isBeginning}\n        >\n          <LeftArrowSliderSVG aria-hidden=\"true\" />\n        </button>\n\n        <button\n          type=\"button\"\n          className={clsx(\n            'swiper-btn swiper-btn-next',\n            nextClass,\n            isEnd ? 'opacity-35' : 'opacity-100',\n          )}\n          aria-label={`다음 슬라이드, 현재 ${activeSlideIndex + 1}번 슬라이드, 전체 ${totalSlides}개`}\n          disabled={isEnd}\n          aria-controls={swiperId}\n        >\n          <RightArrowSliderSVG aria-hidden=\"true\" />\n        </button>\n        <Swiper {...option} id={swiperId}>\n          {children}\n        </Swiper>\n      </div>\n    </div>\n  )\n}\n\nexport { SwiperSlide }\nexport default SwiperSlider\n"]]},"created_time":1741140641725,"last_edited_time":1741140641728,"parent_id":"1a823329-f081-8098-928b-dc28708c4f4d","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"hr28IyWmKHiWiCvzArDSHg,\"start\",\"end\"","n":{"hr28IyWmKHiWiCvzArDSHg,\"start\",\"end\"":{"s":{"x":"hr28IyWmKHiWiCvzArDSHg","i":[{"t":"s"},{"t":"t","i":["2XvXnNIci4dz",1],"o":"start","l":4483,"c":"'use client'\n\n// Import Swiper React components\nimport { Swiper, SwiperSlide } from 'swiper/react'\nimport SwiperCore from 'swiper'\nimport { Navigation, Pagination, A11y } from 'swiper/modules'\n\n// Import Swiper styles\nimport 'swiper/css'\n\nimport {\n  ReactNode,\n  useMemo,\n  useState,\n  useRef,\n  useCallback,\n  useEffect,\n} from 'react'\nimport clsx from 'clsx'\nimport { LeftArrowSliderSVG, RightArrowSliderSVG } from '@/assets/icon'\n\nconst generateUniqueId = (prefix: string) =>\n  `${prefix}-${Math.random().toString(36).substr(2, 6)}`\n\ninterface SwiperSliderProps {\n  children: ReactNode\n  title?: string // 캐러셀 제목 추가\n  slidesPerView?: number\n  spaceBetween?: number\n  className?: string\n}\n\n/**\n * 웹 접근성 가이드라인을 준수한 Swiper 슬라이더 컴포넌트\n *\n * 접근성 구현 가이드라인:\n * 1. 자동 재생 제외 (이 컴포넌트에서는 구현하지 않음)\n * 2. Tab 및 Shift+Tab 키 이동: 자연스러운 탭 순서 유지\n * 3. 버튼 요소의 키보드 상호작용: Enter/Space 키 지원\n * 4. 컨트롤 버튼의 위치: 캐러셀 내용보다 먼저 배치\n * 5. 슬라이드 선택기: 필요에 따라 접근성 지원\n */\nconst SwiperSlider = ({\n  children,\n  title = '강좌 슬라이더',\n  slidesPerView = 4,\n  spaceBetween = 24,\n  className,\n}: SwiperSliderProps) => {\n  // 모듈 포함 - A11y 모듈 추가\n  SwiperCore.use([Navigation, Pagination, A11y])\n\n  // 슬라이더 상태 관리\n  const [isEnd, setIsEnd] = useState<boolean>(false)\n  const [isBeginning, setIsBeginning] = useState<boolean>(true)\n  const [activeSlideIndex, setActiveSlideIndex] = useState<number>(0)\n  const [totalSlides, setTotalSlides] = useState<number>(0)\n\n  const swiperRef = useRef<SwiperCore | null>(null)\n  const uniqueId = useRef(generateUniqueId('slider')).current\n  const titleId = useRef(generateUniqueId('title')).current\n  const swiperId = useRef(generateUniqueId('swiper-container')).current\n\n  const prevClass = `prev-swiper-nav-${uniqueId}`\n  const nextClass = `next-swiper-nav-${uniqueId}`\n\n  const updateInertAttribute = useCallback((swiper: SwiperCore) => {\n    swiper.slides.forEach((slide, index) => {\n      const isVisible =\n        index >= swiper.activeIndex && index < swiper.activeIndex + 4\n      if (isVisible) {\n        slide.removeAttribute('inert')\n        slide.setAttribute('aria-hidden', 'false')\n      } else {\n        slide.setAttribute('inert', '')\n        slide.setAttribute('aria-hidden', 'true')\n      }\n    })\n  }, [])\n\n  const option = useMemo(() => {\n    return {\n      spaceBetween,\n      slidesPerView,\n      modules: [Pagination, Navigation, A11y],\n      navigation: {\n        nextEl: clsx('.' + nextClass),\n        prevEl: clsx('.' + prevClass),\n      },\n      onSwiper: (swiper: SwiperCore) => {\n        swiperRef.current = swiper\n        setTotalSlides(swiper.slides.length)\n      },\n      onInit: (swiper: SwiperCore) => {\n        updateInertAttribute(swiper)\n      },\n      onSlideChange: (swiper: SwiperCore) => {\n        updateInertAttribute(swiper)\n        setActiveSlideIndex(swiper.activeIndex)\n        setIsBeginning(swiper.isBeginning)\n        setIsEnd(swiper.isEnd)\n      },\n      // 가이드라인 #2: 접근성 개선을 위한 A11y 옵션 설정\n      a11y: {\n        enabled: true,\n        containerMessage: title,\n        containerRoleDescriptionMessage: 'carousel',\n        itemRoleDescriptionMessage: 'slide',\n      },\n    }\n  }, [slidesPerView, spaceBetween, title])\n\n  return (\n    <div className={clsx('nav-style', className)} aria-labelledby={titleId}>\n      <h2 id={titleId} className=\"sr-only\">\n        {title}\n      </h2>\n\n      {/* 가이드라인 #2 & #4: 컨트롤을 캐러셀 앞에 배치하여 탭 순서 개선 \n          키보드 사용자가 콘텐츠 탐색 전에 컨트롤에 접근할 수 있도록 함 */}\n      <div className=\"swiper-controls\">\n        <button\n          type=\"button\"\n          className={clsx(\n            'swiper-btn swiper-btn-prev',\n            prevClass,\n            isBeginning ? 'opacity-35' : 'opacity-100',\n          )}\n          aria-label={`이전 슬라이드, 현재 ${activeSlideIndex + 1}번 슬라이드, 전체 ${totalSlides}개`}\n          aria-controls={swiperId}\n          disabled={isBeginning}\n        >\n          <LeftArrowSliderSVG aria-hidden=\"true\" />\n        </button>\n\n        <button\n          type=\"button\"\n          className={clsx(\n            'swiper-btn swiper-btn-next',\n            nextClass,\n            isEnd ? 'opacity-35' : 'opacity-100',\n          )}\n          aria-label={`다음 슬라이드, 현재 ${activeSlideIndex + 1}번 슬라이드, 전체 ${totalSlides}개`}\n          disabled={isEnd}\n          aria-controls={swiperId}\n        >\n          <RightArrowSliderSVG aria-hidden=\"true\" />\n        </button>\n        <Swiper {...option} id={swiperId}>\n          {children}\n        </Swiper>\n      </div>\n    </div>\n  )\n}\n\nexport { SwiperSlide }\nexport default SwiperSlider\n"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1ad23329-f081-80d0-89f0-d214e4404f30":{"value":{"value":{"id":"1ad23329-f081-80d0-89f0-d214e4404f30","version":4,"type":"text","created_time":1741140625379,"last_edited_time":1741140625380,"parent_id":"1a823329-f081-8098-928b-dc28708c4f4d","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"ak1EPw1Y2CIrcnVAzGUPlg,\"start\",\"end\"","n":{"ak1EPw1Y2CIrcnVAzGUPlg,\"start\",\"end\"":{"s":{"x":"ak1EPw1Y2CIrcnVAzGUPlg","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1ad23329-f081-80cf-b880-f4334ae38c22":{"value":{"value":{"id":"1ad23329-f081-80cf-b880-f4334ae38c22","version":3,"type":"bulleted_list","properties":{"title":[["aria-labelledby",[["c"]]],[" 속성을 통해 슬라이더 컴포넌트를 제목과 연결"]]},"created_time":1741140767229,"last_edited_time":1741140767246,"parent_id":"1ad23329-f081-8066-afda-e85e97aa1254","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"udn7GaYT4DG0IHzsizacuw,\"start\",\"end\"","n":{"udn7GaYT4DG0IHzsizacuw,\"start\",\"end\"":{"s":{"x":"udn7GaYT4DG0IHzsizacuw","i":[{"t":"s"},{"t":"t","i":["637C2exU-CRH",1],"o":"start","l":15,"c":"aria-labelledby","b":[{"t":"a","x":"udn7GaYT4DG0IHzsizacuw","l":"","i":["637C2exU-CRH",41],"s":{"i":["637C2exU-CRH",1],"a":"b"},"e":{"i":["637C2exU-CRH",16],"a":"b"},"a":["c"]}]},{"t":"t","i":["637C2exU-CRH",16],"o":["637C2exU-CRH",15],"l":25,"c":" 속성을 통해 슬라이더 컴포넌트를 제목과 연결","b":[]},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1ad23329-f081-80d2-ad97-e112833c58ea":{"value":{"value":{"id":"1ad23329-f081-80d2-ad97-e112833c58ea","version":3,"type":"bulleted_list","properties":{"title":[["aria-label