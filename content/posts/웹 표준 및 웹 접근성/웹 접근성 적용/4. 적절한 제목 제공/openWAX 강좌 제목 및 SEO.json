ted_time":1740100014896,"last_edited_time":1740100126603,"parent_id":"1a123329-f081-801f-8552-fe525f4cc21c","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"_jXyW0hBRytMcPx8uaGq5Q,\"start\",\"end\"","n":{"_jXyW0hBRytMcPx8uaGq5Q,\"start\",\"end\"":{"s":{"x":"_jXyW0hBRytMcPx8uaGq5Q","i":[{"t":"s"},{"t":"t","i":["W3M6_KzgKJLf",1],"o":"start","l":2,"c":"예제"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1a123329-f081-80b9-8d95-f2021858012f":{"value":{"value":{"id":"1a123329-f081-80b9-8d95-f2021858012f","version":19,"type":"code","properties":{"title":[["import type { Metadata, ResolvingMetadata } from 'next'\n \ntype Props = {\n  params: { id: string }\n  searchParams: { [key: string]: string | string[] | undefined }\n}\n \nexport async function generateMetadata(\n  { params, searchParams }: Props,\n  parent: ResolvingMetadata,\n): Promise<Metadata> {\n  // 경로 매개변수 읽기\n  const id = params.id\n \n  // 데이터 가져오기\n  const product = await fetch(`https://.../${id}`).then((res) => res.json())\n \n  // 선택적으로 상위 메타데이터를 접근하고 확장(대체하지 않음)\n  const previousImages = (await parent).openGraph?.images || []\n \n  return {\n    title: product.title,\n    openGraph: {\n      images: ['/some-specific-page-image.jpg', ...previousImages],\n    },\n  }\n}\n \nexport default function Page({ params, searchParams }: Props) {}"]],"language":[["TypeScript"]]},"created_time":1740100105549,"last_edited_time":1740100117532,"parent_id":"1a123329-f081-801f-8552-fe525f4cc21c","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"_eb7_KG_s3uNuK-6PIIptA,\"start\",\"end\"","n":{"_eb7_KG_s3uNuK-6PIIptA,\"start\",\"end\"":{"s":{"x":"_eb7_KG_s3uNuK-6PIIptA","i":[{"t":"s"},{"t":"t","i":["kN49bRo3d4QI",1],"o":"start","l":733,"c":"import type { Metadata, ResolvingMetadata } from 'next'\n \ntype Props = {\n  params: { id: string }\n  searchParams: { [key: string]: string | string[] | undefined }\n}\n \nexport async function generateMetadata(\n  { params, searchParams }: Props,\n  parent: ResolvingMetadata,\n): Promise<Metadata> {\n  // 경로 매개변수 읽기\n  const id = params.id\n \n  // 데이터 가져오기\n  const product = await fetch(`https://.../${id}`).then((res) => res.json())\n \n  // 선택적으로 상위 메타데이터를 접근하고 확장(대체하지 않음)\n  const previousImages = (await parent).openGraph?.images || []\n \n  return {\n    title: product.title,\n    openGraph: {\n      images: ['/some-specific-page-image.jpg', ...previousImages],\n    },\n  }\n}\n \nexport default function Page({ params, searchParams }: Props) {}"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1a123329-f081-80a6-b764-c7c2572070c0":{"value":{"value":{"id":"1a123329-f081-80a6-b764-c7c2572070c0","version":4,"type":"text","created_time":1740101467459,"last_edited_time":1740101467460,"parent_id":"1a123329-f081-801f-8552-fe525f4cc21c","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"G7BaSjY3ObBm5iYOa4XZIw,\"start\",\"end\"","n":{"G7BaSjY3ObBm5iYOa4XZIw,\"start\",\"end\"":{"s":{"x":"G7BaSjY3ObBm5iYOa4XZIw","i":[{"t":"s"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1a123329-f081-802c-9226-fc3e65cae4b6":{"value":{"value":{"id":"1a123329-f081-802c-9226-fc3e65cae4b6","version":110,"type":"sub_sub_header","properties":{"title":[["설정 (각 페이지 별)"]]},"created_time":1740101466858,"last_edited_time":1740101475079,"parent_id":"1a123329-f081-801f-8552-fe525f4cc21c","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"SKt4TV3TR-Q-8ea-fPH76A,\"start\",\"end\"","n":{"SKt4TV3TR-Q-8ea-fPH76A,\"start\",\"end\"":{"s":{"x":"SKt4TV3TR-Q-8ea-fPH76A","i":[{"t":"s"},{"t":"t","i":["nscou4Qzp_S3",1],"o":"start","l":12,"c":"설정 (각 페이지 별)"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"1a123329-f081-8095-b58b-e2baf3176660":