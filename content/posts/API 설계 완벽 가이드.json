ail = searchParams.get('email')\n\n    if (!email) {\n      return NextResponse.json({\n        code: 'INVALID_PARAMETER',\n        message: '이메일이 필요합니다.',\n      }, { status: 400 })\n    }\n\n// 2. 비즈니스 로직\n    const result = await processLogic(email)\n\n    if (!result) {\n      return NextResponse.json({\n        code: 'NOT_FOUND',\n        message: '데이터를 찾을 수 없습니다.',\n      }, { status: 404 })\n    }\n\n// 3. 성공 응답\n    return NextResponse.json({\n      code: 'SUCCESS',\n      message: '조회 완료',\n      data: result\n    }, { status: 200 })\n\n  } catch (error) {\n// 4. 예외 처리\n    return NextResponse.json({\n      code: 'SERVER_ERROR',\n      message: '서버 오류가 발생했습니다.',\n    }, { status: 500 })\n  }\n}\n"]],"language":[["JavaScript"]]},"format":{"code_wrap":true},"created_time":1751619089633,"last_edited_time":1751619089661,"parent_id":"22623329-f081-80fd-8314-e5a43747a63a","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"geUDTNm0YxpGnoDXU_kyKQ,\"start\",\"end\"","n":{"geUDTNm0YxpGnoDXU_kyKQ,\"start\",\"end\"":{"s":{"x":"geUDTNm0YxpGnoDXU_kyKQ","i":[{"t":"s"},{"t":"t","i":["71nkmpale1C7",1],"o":"start","l":935,"c":"\n\njavascript\n// app/api/example/route.ts\nimport { NextRequest, NextResponse } from 'next/server'\n\nexport async function GET(request: NextRequest): Promise<NextResponse> {\n  try {\n// 1. 파라미터 검증\n    const { searchParams } = new URL(request.url)\n    const email = searchParams.get('email')\n\n    if (!email) {\n      return NextResponse.json({\n        code: 'INVALID_PARAMETER',\n        message: '이메일이 필요합니다.',\n      }, { status: 400 })\n    }\n\n// 2. 비즈니스 로직\n    const result = await processLogic(email)\n\n    if (!result) {\n      return NextResponse.json({\n        code: 'NOT_FOUND',\n        message: '데이터를 찾을 수 없습니다.',\n      }, { status: 404 })\n    }\n\n// 3. 성공 응답\n    return NextResponse.json({\n      code: 'SUCCESS',\n      message: '조회 완료',\n      da