onst [isLoading, setIsLoading] = useState()\n  const [error, setError] = useState()\n\n  const sendRequest = useCallback(\n    async function sendRequest() {\n      setIsLoading(true)\n      try {\n        const resData = sendHttpRequest(url, config)\n        setData(resData)\n      } catch (error) {\n        setError(error.message || 'Something went wrong')\n        setIsLoading(false)\n      }\n    },\n    [url, config],\n  )\n\n  useEffect(() => {\n    if (config && config.method === 'GET') {\n      sendRequest()\n    }\n  }, [sendRequest, config])\n\n  return {\n    data,\n    isLoading,\n    error,\n    sendRequest\n  }\n}\n"]],"language":[["TypeScript"]]},"created_time":1710318021574,"last_edited_time":1710318021959,"parent_id":"515e4dce-8dc8-43b7-9b2d-ec0b44efc670","parent_table":"block","alive":true,"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"0TALYD1LbnvAbUnO2clYLA,\"start\",\"end\"","n":{"0TALYD1LbnvAbUnO2clYLA,\"start\",\"end\"":{"s":{"x":"0TALYD1LbnvAbUnO2clYLA","i":[{"t":"s"},{"t":"t","i":["8uxUgDXuOUTH",1],"o":"start","l":1029,"c":"import { useCallback, useEffect, useState } from 'react'\n\nasync function sendHttpRequest(url, config) {\n  const response = await fetch(url, config)\n\n  const resData = await response.json()\n\n  if (!response.ok) {\n    throw new Error(\n      resData.message || 'Somthing went wrong, faild to send request',\n    )\n  }\n\n  return resData\n}\n\nexport default function useHttp(url, config) {\n  const [data, setData] = useState()\n  const [isLoading, setIsLoading] = useState()\n  const [error, setError] = useState()\n\n  const sendRequest = useCallback(\n    async function sendRequest() {\n      setIsLoading(true)\n      try {\n        const resData = sendHttpRequest(url, config)\n        setData(resData)\n      } catch (error) {\n        setError(error.message || 'Something went wrong')\n        setIsLoading(false)\n      }\n    },\n    [url, config],\n  )\n\n  useEffect(() => {\n    if (config && config.method === 'GET') {\n      sendRequest()\n    }\n  }, [sendRequest, config])\n\n  return {\n    data,\n    isLoading,\n    error,\n    sendRequest\n  }\n}\n"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"362e7066-4abd-4b21-a038-dc2e92e8dc73":{"value":{"value":{"id":"362e7066-4abd-4b21-a038-dc2e92e8dc73","version":14,"type":"image","properties":{"size":[["66.3KB"]],"title":[["Untitled"]],"source":[["https://prod-files-secure.s3.us-west-2.amazonaws.com/42226e73-10fb-44ef-86b2-97a01d83a329/df36234c-bca7-4896-911d-a103b2b146dd/Untitled.png"]]},"format":{"block_width":707.9971313476562,"display_source":"https://prod-files-secure.s3.us-west-2.amazonaws.com/42226e73-10fb-44ef-86b2-97a01d83a329/df36234c-bca7-4896-911d-a103b2b146dd/Untitled.png","block_full_width":false,"block_page_width":true,"block_aspect_ratio":0.3518005540166205,"block_preserve_scale":true},"created_time":1710318600835,"last_edited_time":1710318604510,"parent_id":"515e4dce-8dc8-43b7-9b2d-ec0b44efc670","parent_table":"block","alive":true,"file_ids":["df36234c-bca7-4896-911d-a103b2b146dd"],"space_id":"42226e73-10fb-44ef-86b2-97a01d83a329","crdt_format_version":1,"crdt_data":{"title":{"r":"stfgG5aJqiMJXKAhElkL_A,\"start\",\"end\"","n":{"stfgG5aJqiMJXKAhElkL_A,\"start\",\"end\"":{"s":{"x":"stfgG5aJqiMJXKAhElkL_A","i":[{"t":"s"},{"t":"t","i":["bpaY0iE5-AjI",1],"o":"start","l":8,"c":"Untitled"},{"t":"e"}],"l":""},"c":[]}}}}},"role":"reader"}},"9013b251-67da-4206-94ae-f4f8fc8f82a0":{"value":{"value":{"id":"9013b251-67da-4206-94ae-f4f8fc8f82a0","version":14,"type":"image","properties":{"size":[["38.6KB"]],"title":[["Untitled"]],"source":[["https://prod-files-secure.s3.us-west-2.amazonaws.com/42226e73-10fb-44ef-86b2-97a01d83a329/0bbec8a0-a571-465b-80eb-4849c3c04796/Untitled.png"]]},"format":{"block_width":703.9625244140625,"display_source":"https://prod-files-secure.s3.us-west-2.amazonaws.com/42226e73-10fb-44ef-86b2-97a01d83a329/0bbec8a0-a571-465b-80eb-4849c3c04796/Unti